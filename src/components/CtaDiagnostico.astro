---
// Banda de cierre que invita al diagnóstico inicial.
// `servicio` preselecciona la opción en el formulario de /contacto.
import { contacto } from '../data/sitio';

interface Props {
  servicio?: string;
  title?: string;
  text?: string;
}
const {
  servicio = '',
  title = '¿Por dónde empezar? Por un diagnóstico.',
  text = 'Relevamos cómo trabajás hoy y qué te piden la norma, tus clientes o la ley. Con eso te decimos qué hace falta, en qué orden y cuánto trabajo lleva.',
} = Astro.props;
const href = servicio ? `/contacto?servicio=${encodeURIComponent(servicio)}#formulario` : '/contacto#formulario';
---
<section class="cta">
  <div class="wrap inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="actions">
      <a class="btn btn--primary" href={href}>Solicitar diagnóstico inicial</a>
      <a class="btn btn--ghost" href={contacto.whatsapp} target="_blank" rel="noopener">Escribir por WhatsApp</a>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: clamp(56px, 7vw, 96px); background: var(--primary-soft); }
  .inner { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 32px 56px; align-items: center; }
  @media (max-width: 860px) { .inner { grid-template-columns: 1fr; } }
  h2 { font-size: var(--step-3); max-width: 20ch; }
  p { color: var(--text); margin: 16px 0 0; max-width: 58ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .btn--ghost { background: #fff; }
</style>
