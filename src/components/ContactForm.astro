---
// Formulario corto de contacto / diagnóstico inicial.
// Usa Netlify Forms: funciona cuando el sitio está publicado en Netlify. En la
// vista local no se envía (el formulario lo avisa).
import { servicios, contacto } from '../data/sitio';

interface Props { servicio?: string; }
const { servicio = '' } = Astro.props;
---
<form
  class="form"
  name="diagnostico"
  method="POST"
  action="/gracias/"
  data-netlify="true"
  netlify-honeypot="bot-field"
>
  <input type="hidden" name="form-name" value="diagnostico" />
  <!-- Trampa para robots: oculta del todo y con un nombre que el autocompletado no reconoce.
       Si llega llena, Netlify descarta el envío. -->
  <p hidden aria-hidden="true"><label>No completar: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

  <div class="row">
    <div class="field">
      <label for="f-nombre">Nombre y apellido</label>
      <input id="f-nombre" name="nombre" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="f-empresa">Empresa <span class="opt">(opcional)</span></label>
      <input id="f-empresa" name="empresa" type="text" autocomplete="organization" />
    </div>
  </div>

  <div class="row">
    <div class="field">
      <label for="f-email">Email</label>
      <input id="f-email" name="email" type="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for="f-telefono">Teléfono <span class="opt">(opcional)</span></label>
      <input id="f-telefono" name="telefono" type="tel" autocomplete="tel" />
    </div>
  </div>

  <div class="field">
    <label for="f-servicio">¿En qué te podemos ayudar?</label>
    <select id="f-servicio" name="servicio">
      <option value="">Elegí una opción</option>
      {servicios.map((s) => <option value={s.id} selected={s.id === servicio}>{s.nombre}</option>)}
      <option value="otro" selected={servicio === 'otro'}>Otra consulta</option>
    </select>
  </div>

  <div class="field">
    <label for="f-mensaje">Contanos brevemente tu situación <span class="opt">(opcional)</span></label>
    <textarea id="f-mensaje" name="mensaje" rows="4"></textarea>
  </div>

  <p class="form-error" data-error role="alert" hidden>
    No pudimos enviar tu mensaje. Probá de nuevo en un rato, o escribinos por
    <a href={contacto.whatsapp} target="_blank" rel="noopener">WhatsApp</a> o a
    <a href={`mailto:${contacto.email}`}>{contacto.email}</a>.
  </p>
  <p class="form-aviso" data-local hidden>
    En la vista local el formulario no se envía: funciona en el sitio publicado en Netlify.
  </p>

  <button class="btn btn--primary" type="submit">Enviar solicitud</button>
  <p class="nota">Te contactamos para coordinar una primera conversación. No vendemos ni compartimos tus datos con terceros sin tu consentimiento, salvo que la ley lo exija.</p>
</form>

<script>
  // Envío con fetch: si Netlify lo recibe, va a /gracias/; si falla, avisa y ofrece WhatsApp
  // y email. Sin JavaScript el formulario se envía igual, de la forma común.
  document.querySelectorAll<HTMLFormElement>('form[name="diagnostico"]').forEach((form) => {
    const boton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const error = form.querySelector<HTMLElement>('[data-error]');
    const local = form.querySelector<HTMLElement>('[data-local]');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (error) error.hidden = true;
      if (['localhost', '127.0.0.1'].includes(location.hostname)) {
        if (local) local.hidden = false;
        return;
      }
      const texto = boton?.textContent ?? 'Enviar solicitud';
      if (boton) { boton.disabled = true; boton.textContent = 'Enviando…'; }
      try {
        const respuesta = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(new FormData(form) as any).toString(),
        });
        if (!respuesta.ok) throw new Error(String(respuesta.status));
        location.href = form.getAttribute('action') || '/gracias/';
      } catch {
        if (error) error.hidden = false;
        if (boton) { boton.disabled = false; boton.textContent = texto; }
      }
    });
  });

  // Preselecciona el servicio si la URL trae ?servicio=...
  const valor = new URLSearchParams(location.search).get('servicio');
  const select = document.querySelector<HTMLSelectElement>('#f-servicio');
  if (valor && select && [...select.options].some((o) => o.value === valor)) select.value = valor;
</script>

<style>
  .form { display: grid; gap: 18px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  @media (max-width: 620px) { .row { grid-template-columns: 1fr; } }
  .field { display: grid; gap: 6px; }
  label { font-family: var(--font-display); font-weight: 500; font-size: 0.95rem; color: var(--ink); }
  .opt { font-weight: 400; color: var(--muted); }
  input, select, textarea {
    font: inherit; font-size: 1rem; color: var(--ink);
    width: 100%; padding: 12px 14px; min-height: 48px;
    background: #fff; border: 1px solid var(--line-strong); border-radius: 8px;
  }
  textarea { resize: vertical; min-height: 110px; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px var(--primary-soft); }
  .btn { justify-self: start; }
  .nota { margin: 0; font-size: 0.875rem; color: var(--muted); }
  .form-error, .form-aviso { margin: 0; padding: 12px 14px; border-radius: 8px; font-size: 0.95rem; }
  .form-error { background: #fdf2f2; border: 1px solid #efc4c4; color: #8a1f1f; }
  .form-error a { color: inherit; }
  .form-aviso { background: var(--paper); border: 1px solid var(--line); color: var(--text); }
  .btn:disabled { opacity: 0.7; cursor: progress; }
</style>
