---
// Ilustraciones de línea para los encabezados de página. Son decorativas (aria-hidden):
// el texto de la página ya dice todo. Colores de la marca, sin degradados ni resplandores.
// Se dibujan al cargar y tienen un movimiento suave; con «reducir movimiento» quedan quietas.
interface Props {
  tema: 'iso' | 'alimentaria' | 'lean' | 'vciso' | 'cursos' | 'contacto';
}
const { tema } = Astro.props;
---
<div class={`ilus ilus--${tema}`} aria-hidden="true">
  {tema === 'iso' && (
    <svg viewBox="0 0 400 320">
      <circle class="fondo" cx="220" cy="160" r="142" />
      <rect class="l f dib" pathLength="1" x="170" y="62" width="150" height="196" rx="12" />
      <rect class="l s" x="215" y="50" width="60" height="24" rx="7" />
      {[104, 150, 196].map((y, i) => (
        <g>
          <rect class="l f" x="192" y={y} width="22" height="22" rx="5" />
          <path class="tilde" pathLength="1" style={`--d:${0.9 + i * 0.35}s`} d={`M197 ${y + 11} l5 5 l9 -11`} />
          <path class="l suave" d={`M228 ${y + 7} h70`} />
          <path class="l suave" d={`M228 ${y + 17} h44`} />
        </g>
      ))}
      <circle class="l f" cx="110" cy="215" r="62" />
      <path class="arco dib" pathLength="1" style="--d:.2s" d="M118 169.7 A46 46 0 0 1 155.3 207" />
      <path class="arco dib" pathLength="1" style="--d:.45s" d="M155.3 223 A46 46 0 0 1 118 260.3" />
      <path class="arco dib" pathLength="1" style="--d:.7s" d="M102 260.3 A46 46 0 0 1 64.7 223" />
      <path class="arco dib" pathLength="1" style="--d:.95s" d="M64.7 207 A46 46 0 0 1 102 169.7" />
      <text x="127" y="199">P</text>
      <text x="127" y="232">H</text>
      <text x="93" y="232">V</text>
      <text x="93" y="199">A</text>
      <g class="gira" style="transform-origin:110px 215px"><circle class="punto" cx="110" cy="169" r="5" /></g>
    </svg>
  )}

  {tema === 'alimentaria' && (
    <svg viewBox="0 0 400 320">
      <defs>
        <clipPath id="ilus-cinta"><rect x="55" y="120" width="290" height="102" /></clipPath>
      </defs>
      <circle class="fondo" cx="205" cy="165" r="142" />
      <path class="l suave" d="M60 288 h280" />
      <path class="l" d="M92 246 v40 M308 246 v40" />
      <rect class="l f dib" pathLength="1" x="50" y="220" width="300" height="26" rx="13" />
      <circle class="l s" cx="72" cy="233" r="6" />
      <circle class="l s" cx="328" cy="233" r="6" />
      <g clip-path="url(#ilus-cinta)">
        <g class="cinta">
          {[20, 120, 220, 320].map((x) => (
            <g>
              <rect class="l f" x={x} y="178" width="34" height="42" rx="6" />
              <rect class="l s" x={x - 2} y="170" width="38" height="10" rx="3" />
              <rect class="etiqueta" x={x + 7} y="193" width="20" height="12" rx="2" />
            </g>
          ))}
        </g>
      </g>
      <path class="l f dib" pathLength="1" d="M300 42 l40 14 v30 c0 30 -19 46 -40 55 c-21 -9 -40 -25 -40 -55 v-30 z" />
      <path class="tilde gruesa" pathLength="1" style="--d:1s" d="M283 92 l11 11 l22 -25" />
      <g class="flota">
        <circle class="l f" cx="122" cy="96" r="28" />
        <path class="l" d="M142 116 l20 20" />
        <path class="l suave" d="M110 92 a14 14 0 0 1 14 -10" />
      </g>
    </svg>
  )}

  {tema === 'lean' && (
    <svg viewBox="0 0 400 320">
      <defs>
        <marker id="ilus-flecha" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto">
          <path class="punta" d="M1 1 L8 5 L1 9" />
        </marker>
      </defs>
      <circle class="fondo" cx="200" cy="165" r="142" />
      <g class="gira" style="transform-origin:178px 92px">
        <circle class="diente" cx="178" cy="92" r="30" />
        <circle class="l f" cx="178" cy="92" r="24" />
        <circle class="l s" cx="178" cy="92" r="8" />
      </g>
      <g class="gira gira--al-reves" style="transform-origin:233px 120px">
        <circle class="diente diente--chico" cx="233" cy="120" r="18" />
        <circle class="l f" cx="233" cy="120" r="13" />
        <circle class="l s" cx="233" cy="120" r="4.5" />
      </g>
      {[50, 165, 280].map((x, i) => (
        <g>
          <rect class="l f dib" pathLength="1" style={`--d:${i * 0.25}s`} x={x} y="176" width="70" height="52" rx="8" />
          <path class="l suave" d={`M${x + 14} 196 h42 M${x + 14} 210 h28`} />
        </g>
      ))}
      <path class="flujo" marker-end="url(#ilus-flecha)" d="M124 202 h36" />
      <path class="flujo" marker-end="url(#ilus-flecha)" d="M239 202 h36" />
      <path class="l suave" d="M50 262 h300" />
      {[85, 200, 315].map((x, i) => (
        <circle class="hito" style={`--d:${1 + i * 0.3}s`} cx={x} cy="262" r="6" />
      ))}
    </svg>
  )}

  {tema === 'vciso' && (
    <svg viewBox="0 0 400 320">
      <circle class="fondo" cx="200" cy="162" r="142" />
      <path class="l suave dib" pathLength="1" style="--d:.5s" d="M96 104 L150 132 M304 104 L250 132 M96 222 L148 198 M304 222 L252 198" />
      <path class="l f dib grueso" pathLength="1" d="M200 90 l58 21 v45 c0 41 -27 65 -58 77 c-31 -12 -58 -36 -58 -77 v-45 z" />
      <path class="l arco-candado" d="M187 152 v-11 a13 13 0 0 1 26 0 v11" />
      <rect class="l s" x="180" y="151" width="40" height="32" rx="6" />
      <circle class="relleno" cx="200" cy="164" r="4" />
      <path class="l" d="M200 167 v7" />
      <g class="nodo" style="--d:0s">
        <circle class="l2 f" cx="72" cy="92" r="32" />
        <rect class="l" x="57" y="80" width="30" height="19" rx="2" />
        <path class="l" d="M51 104 h42" />
      </g>
      <g class="nodo" style="--d:.6s">
        <circle class="l2 f" cx="328" cy="92" r="32" />
        <rect class="l" x="313" y="76" width="30" height="12" rx="2" />
        <rect class="l" x="313" y="94" width="30" height="12" rx="2" />
        <circle class="relleno" cx="320" cy="82" r="1.8" />
        <circle class="relleno" cx="320" cy="100" r="1.8" />
      </g>
      <g class="nodo" style="--d:1.2s">
        <circle class="l2 f" cx="72" cy="234" r="32" />
        <path class="l" d="M62 218 h14 l8 8 v24 h-22 z" />
        <path class="l suave" d="M67 234 h12 M67 242 h12" />
      </g>
      <g class="nodo" style="--d:1.8s">
        <circle class="l2 f" cx="328" cy="234" r="32" />
        <circle class="l" cx="328" cy="226" r="7" />
        <path class="l" d="M315 249 a13 11 0 0 1 26 0" />
      </g>
    </svg>
  )}

  {tema === 'cursos' && (
    <svg viewBox="0 0 400 320">
      <circle class="fondo" cx="200" cy="165" r="142" />
      <rect class="l f dib" pathLength="1" x="78" y="66" width="244" height="160" rx="10" />
      {[[92, 80], [204, 80], [92, 150], [204, 150]].map(([x, y], i) => (
        <g>
          <rect class="pantalla" style={`--d:${i * 1.5}s`} x={x} y={y} width="104" height="62" rx="5" />
          <circle class="l s" cx={x + 52} cy={y + 24} r="10" />
          <path class="l" d={`M${x + 34} ${y + 54} a18 14 0 0 1 36 0`} />
        </g>
      ))}
      <path class="l f" d="M58 234 h284 l-16 16 h-252 z" />
      <g class="flota">
        <path class="l f" d="M300 26 h70 a10 10 0 0 1 10 10 v26 a10 10 0 0 1 -10 10 h-46 l-14 12 v-12 h-10 a10 10 0 0 1 -10 -10 v-26 a10 10 0 0 1 10 -10 z" />
        <circle class="escribe" style="--d:0s" cx="318" cy="49" r="4" />
        <circle class="escribe" style="--d:.2s" cx="335" cy="49" r="4" />
        <circle class="escribe" style="--d:.4s" cx="352" cy="49" r="4" />
      </g>
    </svg>
  )}

  {tema === 'contacto' && (
    <svg viewBox="0 0 400 320">
      <circle class="fondo" cx="200" cy="165" r="142" />
      <g class="flota">
        <rect class="l f dib" pathLength="1" x="70" y="140" width="170" height="112" rx="10" />
        <path class="l dib" pathLength="1" style="--d:.4s" d="M74 148 l81 58 l81 -58" />
      </g>
      <path class="l f" d="M228 52 h118 a14 14 0 0 1 14 14 v36 a14 14 0 0 1 -14 14 h-80 l-18 16 v-16 h-20 a14 14 0 0 1 -14 -14 v-36 a14 14 0 0 1 14 -14 z" />
      <path class="l suave" d="M236 76 h96 M236 94 h60" />
      <path class="l s" d="M262 160 h86 a12 12 0 0 1 12 12 v22 a12 12 0 0 1 -12 12 h-12 v14 l-16 -14 h-58 a12 12 0 0 1 -12 -12 v-22 a12 12 0 0 1 12 -12 z" />
      <circle class="escribe" style="--d:0s" cx="285" cy="183" r="4.5" />
      <circle class="escribe" style="--d:.2s" cx="305" cy="183" r="4.5" />
      <circle class="escribe" style="--d:.4s" cx="325" cy="183" r="4.5" />
    </svg>
  )}
</div>


<style>
  .ilus { width: 100%; max-width: 400px; justify-self: end; }
  .ilus svg { display: block; width: 100%; height: auto; overflow: visible; }

  .fondo { fill: var(--white); }
  .l, .l2 { fill: none; stroke: var(--primary); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .l2 { stroke: var(--line-strong); stroke-width: 2; }
  .grueso { stroke-width: 3; }
  .f { fill: var(--white); }
  .s { fill: var(--primary-soft); }
  .suave { stroke: var(--line-strong); }
  .relleno { fill: var(--primary); }
  .punto { fill: var(--brand); }
  .etiqueta { fill: var(--primary-soft); }
  .arco { fill: none; stroke: var(--brand); stroke-width: 5; stroke-linecap: round; }
  .tilde { fill: none; stroke: var(--brand); stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; }
  .tilde.gruesa { stroke-width: 6; }
  .punta { fill: none; stroke: var(--primary); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .flujo { fill: none; stroke: var(--primary); stroke-width: 2.5; stroke-linecap: round; stroke-dasharray: 3 7; }
  .diente { fill: none; stroke: var(--primary); stroke-width: 10; stroke-dasharray: 7.85 7.85; }
  .diente--chico { stroke-width: 8; stroke-dasharray: 5.65 5.65; }
  .hito { fill: var(--white); stroke: var(--primary); stroke-width: 2.5; }
  .pantalla { fill: var(--white); stroke: var(--line-strong); stroke-width: 2; }
  .escribe { fill: var(--primary); }
  text { font-family: var(--font-sans); font-size: 16px; font-weight: 900; fill: var(--primary); text-anchor: middle; dominant-baseline: central; }

  /* ---------- Movimiento ---------- */
  @keyframes dibujar { from { stroke-dasharray: 1; stroke-dashoffset: 1; } to { stroke-dasharray: 1; stroke-dashoffset: 0; } }
  .dib { animation: dibujar 1.3s cubic-bezier(0.4, 0, 0.2, 1) var(--d, 0s) both; }
  .tilde { animation: dibujar 0.5s ease-out var(--d, 0s) both; }

  @keyframes girar { to { transform: rotate(360deg); } }
  .gira { animation: girar 14s linear infinite; }
  .gira--al-reves { animation-direction: reverse; animation-duration: 9.3s; }
  .ilus--iso .gira { animation-duration: 7s; }

  @keyframes flotar { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }
  .flota { animation: flotar 4.5s ease-in-out infinite; }

  @keyframes avanzar { to { transform: translateX(100px); } }
  .cinta { animation: avanzar 4s linear infinite; }

  @keyframes fluir { to { stroke-dashoffset: -20; } }
  .flujo { animation: fluir 1s linear infinite; }

  @keyframes marcar { 0%, 100% { fill: var(--white); } 30%, 70% { fill: var(--brand); } }
  .hito { animation: marcar 3.6s ease-in-out var(--d, 0s) infinite; }

  @keyframes latir { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.06); } }
  .nodo { transform-box: fill-box; transform-origin: center; animation: latir 2.4s ease-in-out var(--d, 0s) infinite; }

  @keyframes cerrar { from { transform: translateY(-9px); } to { transform: none; } }
  .arco-candado { animation: cerrar 0.45s cubic-bezier(0.3, 1.6, 0.5, 1) 1.1s both; }

  @keyframes hablar { 0%, 22% { stroke: var(--brand); stroke-width: 3; } 25%, 100% { stroke: var(--line-strong); stroke-width: 2; } }
  .pantalla { animation: hablar 6s linear var(--d, 0s) infinite; }

  @keyframes escribir { 0%, 60%, 100% { transform: translateY(0); opacity: 0.35; } 30% { transform: translateY(-4px); opacity: 1; } }
  .escribe { animation: escribir 1.2s ease-in-out var(--d, 0s) infinite; }

  @media (prefers-reduced-motion: reduce) {
    .gira, .flota, .cinta, .flujo, .hito, .nodo, .pantalla, .escribe { animation: none; }
  }
</style>
