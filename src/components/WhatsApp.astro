---
import { contacto } from '../data/sitio';
---
<a class="wa" href={contacto.whatsapp} target="_blank" rel="noopener" aria-label="Escribinos por WhatsApp">
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <path d="M16 3.2A12.7 12.7 0 0 0 5.1 22.4L3.3 28.8l6.6-1.7A12.8 12.8 0 1 0 16 3.2Zm0 23.3a10.6 10.6 0 0 1-5.4-1.5l-.4-.2-3.9 1 1-3.8-.2-.4A10.6 10.6 0 1 1 16 26.5Zm5.8-7.9c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1a8.7 8.7 0 0 1-4.3-3.8c-.3-.6.3-.5.9-1.7a.6.6 0 0 0 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 0 0-.9.4 3.7 3.7 0 0 0-1.1 2.7 6.4 6.4 0 0 0 1.3 3.4 14.6 14.6 0 0 0 5.6 5c2.1.9 2.9 1 4 .8a3.4 3.4 0 0 0 2.2-1.6 2.8 2.8 0 0 0 .2-1.6c-.1-.1-.3-.2-.6-.4Z" />
  </svg>
  <span>WhatsApp</span>
</a>

<style>
  .wa {
    position: fixed; right: 20px; bottom: calc(20px + env(safe-area-inset-bottom, 0px)); z-index: 60;
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--wa); color: #fff; text-decoration: none;
    font-family: var(--font-display); font-weight: 600; font-size: 0.98rem;
    padding: 12px 18px 12px 14px; border-radius: 999px;
    box-shadow: 0 10px 26px -10px rgba(10, 60, 55, 0.55);
    transition: transform .15s ease, background-color .15s ease;
  }
  .wa:hover { color: #fff; background: #0e7468; transform: translateY(-2px); }
  .wa svg { width: 24px; height: 24px; fill: currentColor; }
  @media (max-width: 560px) {
    .wa { padding: 14px; }
    .wa span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  }
</style>
