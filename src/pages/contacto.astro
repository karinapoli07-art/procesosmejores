---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import { contacto, formularios } from '../data/sitio';

const sitio = 'https://www.procesosmejores.com/';
const url = 'https://www.procesosmejores.com/contacto';

// Texto visible del perfil de LinkedIn, sin protocolo ni barra final.
const linkedinTexto = contacto.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

// A CONFIRMAR: Rodrigo todavía no validó estos tres pasos.
const despues = [
  {
    titulo: 'Leemos tu consulta',
    texto: 'Revisamos lo que nos contaste y, si falta algún dato, te lo pedimos.',
  },
  {
    titulo: 'Coordinamos una primera conversación',
    texto: 'Te contactamos para entender tu situación: qué necesitás, con qué alcance y en qué plazos.',
  },
  {
    titulo: 'Si corresponde, un diagnóstico inicial',
    texto: 'Relevamos cómo trabajás hoy y qué te piden la norma, tus clientes o la ley. Con eso armamos una propuesta de trabajo.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contacto | Procesos Mejores',
    url,
    inLanguage: 'es-AR',
    isPartOf: { '@type': 'WebSite', name: 'Procesos Mejores', url: sitio },
    mainEntity: {
      '@type': 'ProfessionalService',
      name: 'Procesos Mejores',
      url: sitio,
      logo: 'https://www.procesosmejores.com/logo.png',
      email: contacto.email,
      telephone: contacto.telefono,
      address: { '@type': 'PostalAddress', addressLocality: 'Buenos Aires', addressCountry: 'AR' },
      sameAs: [contacto.linkedin],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer service',
        email: contacto.email,
        telephone: contacto.telefono,
        availableLanguage: 'es',
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: sitio },
      { '@type': 'ListItem', position: 2, name: 'Contacto', item: url },
    ],
  },
];
---
<Base
  title="Contacto y diagnóstico inicial | Procesos Mejores"
  description="Contanos qué necesitás: normas ISO, inocuidad alimentaria, Lean, vCISO o capacitación. Escribinos por el formulario, WhatsApp, email o teléfono."
  jsonLd={jsonLd}
>
  <PageHeader
    eyebrow="Contacto"
    title="Contanos qué necesitás."
    lead="Un proyecto de implementación, una auditoría, una capacitación para tu equipo o una duda sobre una norma. Completá el formulario o escribinos por el canal que prefieras."
    crumbs={[{ label: 'Contacto' }]}
  />

  <!-- ============ FORMULARIO Y CANALES ============ -->
  <section class="section">
    <div class="wrap contact">
      <div class="form-panel" id="formulario">
        <h2>Escribinos</h2>
        <p class="form-intro">
          Para pedir un diagnóstico inicial o consultar por un servicio o una capacitación. Con tu nombre
          y tu email alcanza; si nos contás un poco de tu situación, llegamos mejor preparados a la primera conversación.
        </p>
        <ContactForm />
      </div>

      <aside class="side" aria-label="Otras formas de contacto">
        <div class="block">
          <h2>Canales directos</h2>
          <dl class="channels">
            <div>
              <dt>WhatsApp</dt>
              <dd>
                <a href={contacto.whatsapp} target="_blank" rel="noopener">Abrir conversación</a>
                <span class="hint">Para consultas breves.</span>
              </dd>
            </div>
            <div>
              <dt>Email</dt>
              <dd><a href={`mailto:${contacto.email}`}>{contacto.email}</a></dd>
            </div>
            <div>
              <dt>Teléfono</dt>
              <dd><a href={contacto.telefonoLink}>{contacto.telefono}</a></dd>
            </div>
            <div>
              <dt>LinkedIn</dt>
              <dd>
                <a href={contacto.linkedin} target="_blank" rel="noopener">{linkedinTexto}</a>
                <span class="hint">Rodrigo Arizmendi, fundador.</span>
              </dd>
            </div>
            <div>
              <dt>Ubicación</dt>
              <dd>
                Buenos Aires, Argentina
                <span class="hint">Los cursos son en vivo por Google Meet, desde cualquier país de habla hispana.</span>
              </dd>
            </div>
          </dl>
        </div>

        <div class="block">
          <h2>Qué pasa después</h2>
          <ol class="after">
            {despues.map((p, i) => (
              <li>
                <span class="after-n" aria-hidden="true">{i + 1}</span>
                <div>
                  <h3>{p.titulo}</h3>
                  <p>{p.texto}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </aside>
    </div>
  </section>

  <!-- ============ PREGUNTAS FRECUENTES ============ -->
  <section class="section section--soft" aria-labelledby="titulo-faq">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Antes de escribirnos</p>
        <h2 id="titulo-faq">Algunas dudas habituales.</h2>
      </div>

      <div class="faq">
        <details>
          <summary>No sé bien qué norma necesito. ¿Puedo consultar igual?</summary>
          <div class="answer">
            <p>
              Sí. Contanos qué te pide tu cliente, el mercado o la ley, y cómo trabajan hoy. En la primera
              conversación vemos juntos por dónde conviene empezar.
            </p>
          </div>
        </details>

        <details>
          <summary>Quiero inscribirme a un curso. ¿Es por acá?</summary>
          <div class="answer">
            <p>
              No hace falta: cada curso con fecha tiene su botón de inscripción en la <a href="/cursos">página de cursos</a>.
              Si el que te interesa todavía no tiene fecha, anotate en la
              <a href={formularios.listaDeEspera} target="_blank" rel="noopener">lista de espera</a> y te avisamos cuando abra la inscripción.
            </p>
            <p>
              Si lo que buscás es una capacitación a medida para tu equipo, usá el formulario de esta página
              y elegí <a href="/contacto?servicio=formacion#formulario">Formación</a>.
            </p>
          </div>
        </details>

        <details>
          <summary>¿Qué hacen con los datos que envío?</summary>
          <div class="answer">
            <p>
              Los usamos sólo para responder tu consulta y no los vendemos ni los compartimos con terceros sin tu consentimiento, salvo que la ley lo exija. Podés pedirnos
              en cualquier momento que los corrijamos o los borremos. El detalle está en la
              <a href="/privacidad">política de privacidad</a>.
            </p>
          </div>
        </details>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Formulario y canales ---------- */
  .contact {
    display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 48px 72px; align-items: start;
  }
  @media (max-width: 920px) { .contact { grid-template-columns: 1fr; } }

  .form-panel {
    position: relative; padding: clamp(20px, 4vw, 36px);
    background: var(--white); border: 1px solid var(--line); border-radius: 14px;
    scroll-margin-top: 96px;
  }
  .form-panel h2 { font-size: var(--step-2); }
  .form-intro { color: var(--muted); margin: 12px 0 28px; max-width: 60ch; }

  .side { display: grid; gap: 48px; }
  .block h2 { font-size: var(--step-1); margin-bottom: 16px; }

  .channels { margin: 0; border-top: 1px solid var(--line-strong); }
  .channels > div {
    display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 4px 16px;
    padding-block: 14px; border-bottom: 1px solid var(--line);
  }
  @media (max-width: 400px) { .channels > div { grid-template-columns: 1fr; } }
  .channels dt { color: var(--muted); font-size: var(--step--1); padding-top: 2px; }
  .channels dd { margin: 0; color: var(--ink); display: grid; gap: 2px; }
  .channels a { font-weight: 500; overflow-wrap: anywhere; }
  .hint { color: var(--muted); font-size: var(--step--1); line-height: 1.5; }

  .after { list-style: none; margin: 0; padding: 0; display: grid; }
  .after li {
    display: grid; grid-template-columns: 32px minmax(0, 1fr); gap: 16px;
    padding-block: 16px; border-bottom: 1px solid var(--line);
  }
  .after li:first-child { padding-top: 0; }
  .after li:last-child { border-bottom: 0; }
  .after-n {
    width: 32px; height: 32px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--white); border: 1px solid var(--line-strong);
    font-family: var(--font-display); font-weight: 600; font-size: 0.9rem; color: var(--primary);
  }
  .after h3 { font-size: 1.02rem; margin: 5px 0 4px; }
  .after p { margin: 0; color: var(--muted); font-size: 0.95rem; }

  /* ---------- Preguntas frecuentes ---------- */
  /* La regla global `.section-head p` le gana a `.eyebrow`; acá se restituye el estilo de etiqueta. */
  .faq { max-width: 820px; border-top: 1px solid var(--line-strong); }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq summary {
    list-style: none; cursor: pointer;
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; align-items: center;
    padding-block: 20px;
    font-family: var(--font-display); font-weight: 600; font-size: 1.1rem; line-height: 1.35; color: var(--ink);
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after {
    content: '+'; width: 28px; height: 28px; display: grid; place-items: center;
    border: 1px solid var(--line-strong); border-radius: 50%;
    font-weight: 400; font-size: 1.1rem; line-height: 1; color: var(--primary); background: var(--white);
  }
  .faq details[open] summary::after { content: '−'; }
  .faq summary:hover { color: var(--primary); }
  .answer { padding-bottom: 22px; max-width: 68ch; }
  .answer p:last-child { margin-bottom: 0; }
</style>
