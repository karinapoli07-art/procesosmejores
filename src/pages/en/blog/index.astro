---
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import CtaDiagnostico from '../../../components/CtaDiagnostico.astro';
import { obtenerNotas, fechaNota } from '../../../lib/blog';

const notas = obtenerNotas('en');

const inicio = new URL('/en/', Astro.site).href;
const url = new URL('/en/blog', Astro.site).href;
const descripcion =
  'Notes on ISO standards and management systems: how to use ISO 9001 to implement ISO/IEC 27001 and what changed with the climate change amendment.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: inicio },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Notes on management systems',
    description: descripcion,
    url,
    inLanguage: 'en',
    publisher: { '@type': 'Organization', name: 'Procesos Mejores', url: inicio },
    blogPost: notas.map((n) => ({
      '@type': 'BlogPosting',
      headline: n.titulo,
      description: n.descripcion,
      url: new URL(`/en/blog/${n.slug}`, Astro.site).href,
      ...(n.fecha ? { datePublished: n.fecha } : {}),
      author: { '@type': 'Person', name: 'Rodrigo Arizmendi' },
    })),
  },
];
---
<Base
  title="Blog on ISO standards and management systems | Procesos Mejores"
  description={descripcion}
  jsonLd={jsonLd}
>
  <PageHeader
    eyebrow="Blog"
    title="Notes on management systems"
    lead="Changes to the standards and questions that come up when implementing a management system, explained simply. Translated from our Spanish originals."
    crumbs={[{ label: 'Blog' }]}
  />

  <section class="section">
    <div class="wrap">
      <ul class="notas">
        {notas.map((n) => (
          <li class="nota">
            <div class="nota-meta">
              {n.etiquetas.length > 0 && (
                <ul class="chips" aria-label="Topics">
                  {n.etiquetas.map((e) => <li class="chip">{e}</li>)}
                </ul>
              )}
              {n.fecha && <time datetime={n.fecha}>{fechaNota(n.fecha, 'en')}</time>}
            </div>
            <div class="nota-copy">
              <h2><a href={`/en/blog/${n.slug}`}>{n.titulo}</a></h2>
              <p>{n.descripcion}</p>
            </div>
            <a class="link-arrow" href={`/en/blog/${n.slug}`} aria-label={`Read post: ${n.titulo}`}>Read post</a>
          </li>
        ))}
      </ul>

      <p class="mas">
        Is there a topic you would like us to cover? Write to us from the <a href="/en/contact">contact page</a>.
      </p>
    </div>
  </section>

  <CtaDiagnostico />
</Base>

<style>
  .notas { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .nota {
    display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr) auto; gap: 16px 48px;
    align-items: start; padding-block: 32px; border-bottom: 1px solid var(--line);
  }
  @media (max-width: 860px) { .nota { grid-template-columns: 1fr; gap: 14px; padding-block: 28px; } }

  .nota-meta { display: grid; gap: 10px; padding-top: 4px; }
  .nota-meta time { font-size: var(--step--1); color: var(--muted); }
  .chip { white-space: normal; }

  .nota h2 { font-size: var(--step-2); max-width: 30ch; }
  .nota h2 a { color: var(--ink); text-decoration: none; }
  .nota h2 a:hover { color: var(--primary); }
  .nota-copy p { margin: 12px 0 0; color: var(--muted); max-width: 62ch; }
  .nota .link-arrow { padding-top: 6px; }

  .mas { margin: 36px 0 0; color: var(--muted); font-size: 0.97rem; }
</style>
