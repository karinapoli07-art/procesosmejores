---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaDiagnostico from '../components/CtaDiagnostico.astro';
import { contacto } from '../data/sitio';
import rodrigo from '../assets/rodrigo.png';

const url = 'https://www.procesosmejores.com/nosotros';

// Sitio oficial de ROCS (registro desarrollado por IRAM).
const rocsSitio = 'https://rocs.org.ar/';

// A CONFIRMAR: sello ROCS y URL del perfil público de Procesos Mejores.
// Cuando estén disponibles (perfil ROCS > Descarga de archivos digitales):
//   1. Guardar el sello y el QR en src/assets/ (por ejemplo rocs-sello.png y rocs-qr.png).
//   2. Importarlos arriba y asignarlos a selloRocs y qrRocs.
//   3. Pegar la URL del perfil público en perfilRocs.
const selloRocs: ImageMetadata | null = null;
const qrRocs: ImageMetadata | null = null;
const perfilRocs = '';

const recorrido = [
  { label: 'Formación', texto: 'Ingeniero electrónico, con posgrado en ingeniería gerencial.' },
  { label: 'Toyota Argentina', texto: 'Donde se apasionó por la mejora de procesos.' },
  { label: '2012', texto: 'Funda Procesos Mejores y empieza a asesorar empresas de distintos rubros y tamaños.' },
  {
    label: 'Normas',
    texto: 'ISO 9001, ISO 14001, ISO 45001 (antes OHSAS 18001), ISO 21001, ISO 50001, ISO 22000 y FSSC 22000.',
  },
  {
    label: 'Docencia',
    texto: 'En la universidad, en una escuela técnica, en empresas y en capacitaciones a medida. Hoy, también en nuestros cursos en vivo.',
  },
];

const metodo = [
  {
    titulo: '[TEXTO]',
    texto: '[TEXTO]',
  },
  {
    titulo: '[TEXTO]',
    texto: '[TEXTO]',
  },
  {
    titulo: '[TEXTO]',
    texto: '[TEXTO]',
  },
  {
    titulo: '[TEXTO]',
    texto: '[TEXTO]',
  },
];

const valores = ['Honestidad', 'Transparencia', 'Cumplimiento', 'Compromiso'];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'Nosotros | Procesos Mejores',
    url,
    inLanguage: 'es-AR',
    mainEntity: {
      '@type': 'ProfessionalService',
      name: 'Procesos Mejores',
      url: 'https://www.procesosmejores.com/',
      logo: 'https://www.procesosmejores.com/logo.png',
      email: contacto.email,
      foundingDate: '2012',
      founder: {
        '@type': 'Person',
        name: 'Rodrigo Arizmendi',
        jobTitle: 'Fundador',
        description: 'Ingeniero electrónico con posgrado en ingeniería gerencial.',
        sameAs: contacto.linkedin,
      },
      address: { '@type': 'PostalAddress', addressLocality: 'Buenos Aires', addressCountry: 'AR' },
      sameAs: [contacto.linkedin],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.procesosmejores.com/' },
      { '@type': 'ListItem', position: 2, name: 'Nosotros', item: url },
    ],
  },
];
---
<Base
  title="Nosotros: consultoría y docencia desde 2012 | Procesos Mejores"
  description="Consultora argentina de sistemas de gestión fundada en 2012 por Rodrigo Arizmendi. Trabajamos con tu equipo para que el sistema quede funcionando sin nosotros."
  jsonLd={jsonLd}
>
  <PageHeader
    eyebrow="Nosotros"
    title="Consultoría y docencia, desde 2012."
    lead="Somos una consultora argentina de sistemas de gestión y capacitación. Trabajamos con los equipos de cada organización para que, cuando terminemos, el sistema siga funcionando sin nosotros."
    crumbs={[{ label: 'Nosotros' }]}
  />

  <!-- ============ HISTORIA ============ -->
  <section class="section" id="historia">
    <div class="wrap story">
      <figure class="story-photo">
        <Image
          src={rodrigo}
          alt="Rodrigo Arizmendi, fundador de Procesos Mejores"
          width={360}
          widths={[280, 360, 446]}
          sizes="(max-width: 860px) 280px, 360px"
        />
        <figcaption>
          <strong>Rodrigo Arizmendi</strong>
          <span>Fundador de Procesos Mejores</span>
        </figcaption>
      </figure>

      <div class="story-copy">
        <p class="eyebrow">Nuestra historia</p>
        <h2>De Toyota Argentina a Procesos Mejores.</h2>
        <p>
          Rodrigo Arizmendi es ingeniero electrónico y tiene un posgrado en ingeniería gerencial.
          Trabajó en Toyota Argentina, donde se apasionó por la mejora de procesos. De ahí viene la mirada
          que seguimos aplicando: la mejora continua no es un proyecto con fecha de cierre, es una forma de
          trabajar que sostienen las personas que están todos los días en el proceso.
        </p>
        <p>
          En 2012 fundó Procesos Mejores. Desde entonces asesoramos a empresas de distintos rubros y tamaños
          en sistemas de gestión, y combinamos esa tarea con la docencia: las dos se alimentan entre sí.
        </p>

        <dl class="path">
          {recorrido.map((r) => (
            <div>
              <dt>{r.label}</dt>
              <dd>{r.texto}</dd>
            </div>
          ))}
        </dl>

        <a class="link-arrow" href={contacto.linkedin} target="_blank" rel="noopener">Perfil de Rodrigo en LinkedIn</a>
      </div>
    </div>
  </section>

  <!-- ============ TRANSFERENCIA DE CONOCIMIENTO ============ -->
  <section class="section section--soft transfer" id="transferencia-de-conocimiento">
    <div class="wrap">
      <div class="transfer-head">
        <p class="eyebrow">Lo que hacemos, en una idea</p>
        <h2>Transferencia de conocimiento. El sistema tiene que quedar <span>funcionando sin nosotros.</span></h2>
      </div>

      <div class="transfer-grid">
        <div class="transfer-copy">
          <p class="transfer-lead">
            Una consultora de sistemas de gestión no vende carpetas, horas ni un certificado para colgar en la pared.
            Lo que vende es transferencia de conocimiento.
          </p>
          <p>
            Si el sistema sólo lo entiende el consultor, deja de funcionar el día que el consultor se va:
            los registros se atrasan, las auditorías internas se postergan y cada visita del organismo certificador
            se vuelve una urgencia.
          </p>
          <p>
            Por eso medimos nuestro trabajo por lo que tu equipo sabe hacer cuando nos vamos. Y por eso la docencia
            no es un servicio aparte: enseñar es la forma en que hacemos consultoría.
          </p>
        </div>

        <div class="transfer-goal">
          <h3>El objetivo: que al terminar, tu equipo pueda</h3>
          <ul>
            <li>Explicar para qué existe cada proceso, cada procedimiento y cada registro.</li>
            <li>Planificar y hacer sus propias auditorías internas.</li>
            <li>Tratar no conformidades y darles seguimiento con acciones correctivas.</li>
            <li>Preparar la revisión por la dirección con sus propios datos.</li>
            <li>Actualizar el sistema cuando cambian la norma, los clientes o la organización.</li>
          </ul>
        </div>
      </div>

      <ol class="how" aria-label="Cómo lo hacemos">
        {metodo.map((m, i) => (
          <li>
            <span class="how-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{m.titulo}</h3>
            <p>{m.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ POLÍTICA, MISIÓN, VISIÓN Y VALORES ============ -->
  <section class="section" id="politica">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Política, misión, visión y valores</p>
        <h2>Nuestro nombre explica nuestra misión.</h2>
        <p>Lo que nos proponemos, hacia dónde vamos y los compromisos que asumimos con clientes, participantes y proveedores.</p>
      </div>

      <div class="rows">
        <div class="row">
          <h3>Misión</h3>
          <div>
            <p>
              Asesoramos en gestión de procesos y capacitamos. Existimos para cumplir con nuestro nombre:
              procesos mejores. Trabajamos con los equipos y con las personas que nos eligen para que hagan su
              trabajo de forma más eficaz y sostenible, planificando, actuando y evaluando los resultados.
            </p>
          </div>
        </div>

        <div class="row">
          <h3>Visión</h3>
          <div>
            <p>
              Ser referentes en el mercado de habla hispana en mejora de procesos, gestión del cambio y capacitación.
            </p>
          </div>
        </div>

        <div class="row">
          <h3>Valores</h3>
          <ul class="values">
            {valores.map((v) => <li>{v}</li>)}
          </ul>
        </div>

        <div class="row">
          <h3>Política de la calidad</h3>
          <div>
            <p>
              Somos una empresa de consultoría y capacitación. Con la consultoría contribuimos a que las organizaciones
              mejoren sus procesos y crezcan de forma sostenible; con las capacitaciones, a que las personas desarrollen
              competencias profesionales de valor.
            </p>
            <p>
              Nos comprometemos a cumplir los requisitos aplicables y a mejorar de forma continua nuestro sistema de
              gestión de la calidad, para perdurar aportando a la sociedad y generar relaciones de beneficio mutuo con
              clientes y proveedores. Nuestros pilares:
            </p>
            <ol class="pillars">
              <li>Satisfacer a nuestros clientes y ofrecerles más y mejores soluciones.</li>
              <li>Trabajar en equipo, también con nuestros proveedores: comunicación fluida y evaluación continua de su desempeño.</li>
              <li>Mejorar nuestro desempeño de forma continua.</li>
            </ol>
            <p class="signed">Síntesis de la política firmada por Rodrigo Arizmendi, fundador, el 13 de enero de 2023.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ ROCS ============ -->
  <section class="section section--soft" id="rocs">
    <div class="wrap rocs">
      <div class="rocs-copy">
        <p class="eyebrow">Sostenibilidad</p>
        <h2>Organización registrada en ROCS.</h2>
        <p>
          ROCS es el primer Registro de Organizaciones Comprometidas con la Sostenibilidad de Latinoamérica,
          desarrollado por IRAM. Reúne a organizaciones que incorporan criterios ambientales, sociales y de
          gobernanza (ESG) en su gestión y los respaldan con evidencia.
        </p>
        <p>Procesos Mejores está registrada en ROCS: nuestro compromiso ESG fue validado.</p>
        <div class="rocs-links">
          <a class="link-arrow" href={rocsSitio} target="_blank" rel="noopener">Conocer ROCS</a>
          {perfilRocs && (
            <a class="link-arrow" href={perfilRocs} target="_blank" rel="noopener">Ver nuestro perfil en ROCS</a>
          )}
        </div>
      </div>

      <!-- A CONFIRMAR: sello ROCS (descargar desde el perfil ROCS > Descarga de archivos digitales) y URL del perfil público -->
      <aside class="rocs-badge" aria-label="Registro ROCS">
        {(selloRocs || qrRocs) ? (
          <div class="rocs-media">
            {selloRocs && <Image src={selloRocs} alt="Sello ROCS de Procesos Mejores" width={180} />}
            {qrRocs && <Image src={qrRocs} alt="Código QR del perfil de Procesos Mejores en ROCS" width={120} />}
          </div>
        ) : (
          <dl>
            <div><dt>Registro</dt><dd>ROCS, Registro de Organizaciones Comprometidas con la Sostenibilidad</dd></div>
            <div><dt>Desarrollado por</dt><dd>IRAM</dd></div>
            <div><dt>Estado</dt><dd>Compromiso ESG validado</dd></div>
          </dl>
        )}
      </aside>
    </div>
  </section>

  <CtaDiagnostico />
</Base>

<style>
  /* ---------- Historia ---------- */
  .story { display: grid; grid-template-columns: 360px minmax(0, 1fr); gap: 40px 72px; align-items: start; }
  @media (max-width: 860px) { .story { grid-template-columns: 1fr; } }
  .story-photo { margin: 0; }
  .story-photo img {
    width: 100%; max-width: 360px; border-radius: 14px;
    background: var(--soft); border: 1px solid var(--line);
  }
  @media (max-width: 860px) { .story-photo img { max-width: 280px; } }
  .story-photo figcaption { display: grid; gap: 2px; margin-top: 16px; font-size: 0.92rem; }
  .story-photo strong { font-family: var(--font-display); font-weight: 600; color: var(--ink); }
  .story-photo span { color: var(--muted); }
  .story-copy h2 { font-size: var(--step-3); margin-bottom: 24px; }
  .story-copy > p:not(.eyebrow) { max-width: 62ch; }

  .path { margin: 32px 0; padding: 0; border-top: 1px solid var(--line); }
  .path div {
    display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: 4px 24px;
    padding-block: 14px; border-bottom: 1px solid var(--line);
  }
  @media (max-width: 560px) { .path div { grid-template-columns: 1fr; } }
  .path dt { font-family: var(--font-display); font-weight: 600; color: var(--ink); }
  .path dd { margin: 0; color: var(--muted); }

  /* ---------- Transferencia de conocimiento ---------- */
  .transfer { border-block: 1px solid var(--line); }
  .transfer-head { max-width: 900px; margin-bottom: clamp(36px, 5vw, 64px); }
  .transfer-head h2 { font-size: var(--step-4); letter-spacing: -0.03em; }
  .transfer-head h2 span { color: var(--primary); }

  .transfer-grid {
    display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 40px 72px; align-items: start;
  }
  @media (max-width: 920px) { .transfer-grid { grid-template-columns: 1fr; } }
  .transfer-copy p { max-width: 58ch; }
  .transfer-lead {
    font-family: var(--font-display); font-size: var(--step-2); line-height: 1.3;
    color: var(--ink); letter-spacing: -0.01em;
    padding-left: 20px; border-left: 3px solid var(--brand);
    margin-bottom: 28px;
  }

  .transfer-goal {
    background: var(--white); border: 1px solid var(--line); border-radius: var(--radius);
    padding: clamp(24px, 3vw, 36px);
  }
  .transfer-goal h3 { font-size: var(--step-1); margin-bottom: 8px; }
  .transfer-goal ul { list-style: none; margin: 0; padding: 0; }
  .transfer-goal li {
    position: relative; padding: 14px 0 14px 28px;
    border-bottom: 1px solid var(--line); color: var(--text);
  }
  .transfer-goal li:last-child { border-bottom: 0; padding-bottom: 0; }
  .transfer-goal li::before {
    content: ''; position: absolute; left: 2px; top: 22px;
    width: 12px; height: 7px;
    border-left: 2px solid var(--primary); border-bottom: 2px solid var(--primary);
    transform: rotate(-45deg);
  }

  .how {
    list-style: none; margin: clamp(48px, 6vw, 80px) 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px;
  }
  @media (max-width: 980px) { .how { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .how { grid-template-columns: 1fr; gap: 0; } }
  .how li { padding-top: 20px; border-top: 1px solid var(--line-strong); }
  @media (max-width: 560px) { .how li { padding-block: 20px; } }
  .how-n {
    display: block; margin-bottom: 12px;
    font-family: var(--font-display); font-weight: 600; font-size: 0.9rem; color: var(--primary);
  }
  .how h3 { font-size: 1.1rem; margin-bottom: 8px; }
  .how p { margin: 0; color: var(--muted); font-size: 0.97rem; }

  /* ---------- Política, misión, visión y valores ---------- */
  /* .section-head p (global) le gana en especificidad a .eyebrow: se restituye acá. */
  .rows { border-top: 1px solid var(--line); }
  .row {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr); gap: 12px 48px;
    padding-block: 32px; border-bottom: 1px solid var(--line);
  }
  @media (max-width: 760px) { .row { grid-template-columns: 1fr; padding-block: 24px; } }
  .row h3 { font-size: var(--step-1); }
  .row p { max-width: 64ch; }
  .row div > p:last-child { margin-bottom: 0; }

  .values {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px 24px;
  }
  @media (max-width: 760px) { .values { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .values li {
    padding-left: 16px; border-left: 2px solid var(--brand);
    font-family: var(--font-display); font-weight: 600; font-size: var(--step-1); color: var(--ink);
  }

  .pillars { margin: 0 0 1em; padding-left: 1.3em; max-width: 64ch; }
  .pillars li { padding-left: 6px; margin-bottom: 8px; }
  .pillars li::marker { font-family: var(--font-display); font-weight: 600; color: var(--primary); }
  .signed { font-size: var(--step--1); color: var(--muted); }

  /* ---------- ROCS ---------- */
  .rocs { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 40px 72px; align-items: center; }
  @media (max-width: 860px) { .rocs { grid-template-columns: 1fr; } }
  .rocs-copy h2 { font-size: var(--step-3); margin-bottom: 20px; }
  .rocs-copy p:not(.eyebrow) { max-width: 60ch; }
  .rocs-links { display: flex; flex-wrap: wrap; gap: 12px 28px; margin-top: 8px; }

  .rocs-badge {
    background: var(--white); border: 1px solid var(--line); border-radius: var(--radius);
    padding: clamp(24px, 3vw, 32px); position: relative;
  }
  .rocs-badge::before {
    content: ''; position: absolute; left: 24px; right: 24px; top: -1px; height: 3px;
    background: var(--brand); border-radius: 0 0 3px 3px;
  }
  .rocs-badge dl { margin: 0; display: grid; }
  .rocs-badge dl div { display: grid; gap: 2px; padding-block: 12px; border-bottom: 1px solid var(--line); }
  .rocs-badge dl div:first-child { padding-top: 0; }
  .rocs-badge dl div:last-child { border-bottom: 0; padding-bottom: 0; }
  .rocs-badge dt { font-size: var(--step--1); color: var(--muted); }
  .rocs-badge dd { margin: 0; font-family: var(--font-display); font-weight: 600; color: var(--ink); }
  .rocs-media { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; }
</style>
