---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaDiagnostico from '../../components/CtaDiagnostico.astro';
import { servicios } from '../../data/sitio';

const servicio = servicios.find((s) => s.id === 'alimentaria')!;
const contactoHref = '/contacto?servicio=alimentaria#formulario';

const title = 'Consultoría BPM, ISO 22000 y FSSC 22000 | Procesos Mejores';
const description =
  'Implementamos BPM, ISO 22000 y FSSC 22000 en la industria de alimentos: prerrequisitos, análisis de peligros, auditoría interna y preparación para certificar.';

const perfiles = [
  { titulo: 'Plantas elaboradoras', texto: 'De alimentos y bebidas.' },
  { titulo: 'Fraccionadoras y envasadoras', texto: 'Que reenvasan producto de terceros.' },
  { titulo: 'Depósitos y distribución', texto: 'Que almacenan y transportan alimentos.' },
  { titulo: 'Proveedores de la industria', texto: 'A los que sus clientes les exigen BPM o una certificación.' },
];

const normas = [
  {
    id: 'bpm',
    sigla: 'BPM',
    nombre: 'Buenas Prácticas de Manufactura',
    tipo: 'El requisito base',
    texto: 'Las condiciones de higiene y operación que fija el Código Alimentario Argentino. Son el piso que controla la autoridad sanitaria y lo primero que miran tus clientes.',
    incluye: ['Higiene del personal', 'Limpieza y desinfección', 'Control de plagas', 'Agua', 'Almacenamiento'],
    verifica: 'Autoridad sanitaria y auditorías de clientes.',
  },
  {
    id: 'iso-22000',
    sigla: 'ISO 22000',
    nombre: 'Sistema de gestión de la inocuidad',
    tipo: 'El sistema de gestión',
    texto: 'La norma internacional para gestionar la inocuidad: prerrequisitos, HACCP y gestión del sistema. Se integra con ISO 9001 o ISO 14001.',
    incluye: ['PRP', 'HACCP', 'Plan de control de peligros'],
    verifica: 'Un organismo de certificación independiente.',
  },
  {
    id: 'fssc-22000',
    sigla: 'FSSC 22000',
    nombre: 'Esquema de certificación',
    tipo: 'El reconocimiento internacional',
    texto: 'ISO 22000 más requisitos del sector y del esquema, como alérgenos y fraude alimentario. Está reconocido por GFSI, que es lo que piden muchas cadenas y marcas grandes.',
    incluye: ['ISO 22000', 'PRP del sector', 'Reconocido por GFSI'],
    verifica: 'Un organismo licenciado por la Foundation FSSC.',
  },
];

const etapas = [
  { titulo: 'Relevamiento en planta', texto: 'Vemos cómo se trabaja y qué falta. Sale un informe con prioridades.' },
  { titulo: 'Prerrequisitos', texto: 'Limpieza, plagas, agua, higiene, mantenimiento y proveedores.' },
  { titulo: 'Análisis de peligros', texto: 'Con tu equipo de inocuidad, y con sus controles.' },
  { titulo: 'Documentación y capacitación', texto: 'Registros que se usan en la línea y gente que sabe por qué.' },
  { titulo: 'Auditoría interna y certificación', texto: 'Auditamos antes que el organismo y te acompañamos en su auditoría.' },
];

const pageUrl = new URL('/servicios/inocuidad-alimentaria', Astro.site).href;
const siteUrl = new URL('/', Astro.site).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Consultoría en inocuidad alimentaria: BPM, ISO 22000 y FSSC 22000',
    serviceType: 'Consultoría en sistemas de gestión de inocuidad alimentaria',
    description,
    url: pageUrl,
    provider: {
      '@type': 'ProfessionalService',
      name: 'Procesos Mejores',
      url: siteUrl,
    },
    areaServed: { '@type': 'Country', name: 'Argentina' },
    audience: {
      '@type': 'BusinessAudience',
      audienceType: 'Plantas elaboradoras, fraccionadoras, depósitos y proveedores de la industria de alimentos y bebidas',
    },
    about: servicio.normas.map((n) => ({ '@type': 'Thing', name: n })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Servicios', item: new URL('/#servicios', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: servicio.nombre, item: pageUrl },
    ],
  },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <!-- A CONFIRMAR: que el acompañamiento llegue hasta la auditoría de certificación (bajada de la cabecera). -->
  <PageHeader
    eyebrow="Industria de alimentos y bebidas"
    ilustracion="alimentaria"
    title="Inocuidad alimentaria: BPM, ISO 22000 y FSSC 22000"
    lead="Trabajamos en planta, con tu equipo, desde el primer relevamiento hasta la auditoría de certificación."
    crumbs={[{ label: 'Servicios', href: '/#servicios' }, { label: servicio.nombre }]}
  >
    <a class="btn btn--primary" href={contactoHref}>Solicitar diagnóstico inicial</a>
    <a class="btn btn--ghost" href="#normas">Ver las normas</a>
  </PageHeader>

  <!-- ============ PARA QUIÉN ES ============ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Para quién es</p>
        <h2>Para empresas a las que un cliente les empezó a pedir más.</h2>
      </div>
      <ul class="perfiles">
        {perfiles.map((p) => (
          <li>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ LAS NORMAS ============ -->
  <section class="section section--soft" id="normas" aria-labelledby="normas-titulo">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Normas alimentarias</p>
        <h2 id="normas-titulo">Se nombran juntas, pero no son lo mismo.</h2>
      </div>

      <!-- Pestañas: el script de abajo las muestra. Sin JavaScript se ven las tres normas una abajo de la otra. -->
      <div class="tabs" role="tablist" aria-label="Normas alimentarias" hidden>
        {normas.map((n, i) => (
          <button type="button" role="tab" id={`tab-${n.id}`} aria-controls={n.id} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            <span>{n.tipo}</span>{n.sigla}
          </button>
        ))}
      </div>

      <ul class="normas">
        {normas.map((n) => (
          <li class="norma" id={n.id}>
            <div>
              <h3>{n.sigla}</h3>
              <p class="norma-nombre">{n.nombre}</p>
            </div>
            <div class="norma-body">
              <p>{n.texto}</p>
              <ul class="chips" aria-label={`Qué incluye ${n.sigla}`}>
                {n.incluye.map((i) => <li class="chip">{i}</li>)}
              </ul>
              <p class="norma-verifica"><strong>Quién lo verifica:</strong> {n.verifica}</p>
            </div>
          </li>
        ))}
      </ul>

      <p class="nota">
        <strong>No hace falta recorrer las tres.</strong> A algunas empresas les alcanza con las BPM; otras van
        directo a FSSC 22000. Depende de lo que te piden tus clientes.
      </p>
    </div>
  </section>

  <!-- ============ CÓMO TRABAJAMOS ============ -->
  <section class="section">
    <div class="wrap method">
      <div class="method-intro">
        <p class="eyebrow">Cómo trabajamos</p>
        <h2>En la planta, con la gente que produce.</h2>
        <p>Porque son quienes después sostienen el sistema todos los días.</p>
        <!-- A CONFIRMAR: si Rodrigo tiene experiencia previa en ISO 22000 y FSSC 22000 (el sitio anterior no lo dice). Si la confirma, puede volver «Tenemos experiencia en ISO 22000 y FSSC 22000, y también en ISO 9001, ISO 14001 e ISO 45001.» -->
        <!-- A CONFIRMAR: si Rodrigo quiere dar rangos de duración orientativos para BPM, ISO 22000 y FSSC 22000. -->
        <p class="nota-chica">Si ya tenés ISO 9001 u otro sistema, lo integramos. Los plazos se acuerdan en el diagnóstico.</p>
        <a class="btn btn--primary" href={contactoHref}>Empezar por un diagnóstico</a>
      </div>
      <ol class="steps">
        {etapas.map((e, i) => (
          <li>
            <span class="step-n" aria-hidden="true">{i + 1}</span>
            <div>
              <h3>{e.titulo}</h3>
              <p>{e.texto}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ PREGUNTAS FRECUENTES ============ -->
  <section class="section section--soft" aria-labelledby="faq-titulo">
    <div class="wrap faq-grid">
      <div class="faq-intro">
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2 id="faq-titulo">Lo que más nos preguntan.</h2>
        <p>¿Otra duda? <a href={contactoHref}>Escribinos</a>.</p>
      </div>

      <div class="faq">
        <details>
          <summary>¿ISO 22000 o FSSC 22000?</summary>
          <p class="faq-a">Depende de tu cliente. Si exige una certificación reconocida por GFSI, tiene que ser FSSC 22000. Si no, ISO 22000 puede alcanzar y deja hecha buena parte del camino.</p>
        </details>
        <details>
          <summary>¿Necesito BPM antes de ir por ISO 22000?</summary>
          <p class="faq-a">Sí: las BPM son la base que exige ISO 22000, y además las establece el Código Alimentario Argentino. Si ya las tenés, seguimos desde ahí.</p>
        </details>
        <details>
          <summary>¿Ustedes certifican?</summary>
          <p class="faq-a">No. Quien implementa no puede certificar. Certifica un organismo independiente que elegís vos; nosotros te preparamos y te acompañamos en la auditoría.</p>
        </details>
      </div>
    </div>
  </section>

  <CtaDiagnostico
    servicio="alimentaria"
    title="¿Te pidieron BPM o una certificación? Empecemos por un diagnóstico."
    text="Recorremos tu planta y te decimos qué hace falta y en qué orden."
  />
</Base>

<script>
  // Pestañas de las tres normas. Se activan sólo con JavaScript; las flechas del teclado
  // también cambian de pestaña, y un enlace a #bpm, #iso-22000 o #fssc-22000 abre la que corresponde.
  const lista = document.querySelector<HTMLElement>('.tabs');
  if (lista) {
    const tabs = Array.from(lista.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const paneles = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);
    lista.hidden = false;
    paneles[0].parentElement!.setAttribute('role', 'presentation');
    paneles.forEach((p, i) => {
      p.setAttribute('role', 'tabpanel');
      p.setAttribute('aria-labelledby', tabs[i].id);
      p.tabIndex = 0;
    });
    const mostrar = (i: number, foco = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(i === j));
        t.tabIndex = i === j ? 0 : -1;
        paneles[j].hidden = i !== j;
      });
      if (foco) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => mostrar(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') mostrar((i + 1) % tabs.length, true);
        if (e.key === 'ArrowLeft') mostrar((i - 1 + tabs.length) % tabs.length, true);
      });
    });
    const desdeEnlace = paneles.findIndex((p) => `#${p.id}` === location.hash);
    mostrar(desdeEnlace >= 0 ? desdeEnlace : 0);
  }
</script>

<style>
  /* ---------- Para quién ---------- */
  .perfiles {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px;
  }
  .perfiles li {
    padding: 22px; border: 1px solid var(--line-strong); border-radius: var(--radius);
    transition: border-color var(--base) var(--ease), transform var(--base) var(--ease);
  }
  @media (hover: hover) { .perfiles li:hover { border-color: var(--primary); transform: translateY(-3px); } }
  .perfiles h3 { font-size: 1.1rem; margin-bottom: 4px; }
  .perfiles p { margin: 0; color: var(--muted); font-size: 0.95rem; line-height: 1.45; }

  /* ---------- Pestañas de normas ---------- */
  .tabs { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 8px; }
  .tabs[hidden] { display: none; }
  .tabs button {
    flex: 1 1 200px; display: grid; gap: 4px; text-align: left; cursor: pointer;
    padding: 16px 20px; font: inherit; font-size: var(--step-1); font-weight: 700; line-height: 1.2;
    color: var(--ink); background: var(--white);
    border: 1px solid var(--line-strong); border-radius: var(--radius);
    transition: background-color var(--base) var(--ease), border-color var(--base) var(--ease), color var(--base) var(--ease);
  }
  .tabs button span {
    font-size: var(--step--2); letter-spacing: 0.085em; text-transform: uppercase; color: var(--muted);
    transition: color var(--base) var(--ease);
  }
  .tabs button:hover { border-color: var(--primary); }
  .tabs button[aria-selected='true'] { background: var(--primary); border-color: var(--primary); color: var(--white); }
  .tabs button[aria-selected='true'] span { color: rgba(255, 255, 255, 0.82); }
  @media (max-width: 560px) {
    .tabs { gap: 6px; }
    .tabs button { flex: 1 1 0; padding: 12px 8px; font-size: 0.95rem; text-align: center; }
    .tabs button span { display: none; }
  }

  /* ---------- Normas ---------- */
  .normas { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  .norma {
    display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr); gap: 16px 64px;
    padding-block: 32px; border-bottom: 1px solid var(--line-strong);
    scroll-margin-top: 88px;
  }
  .norma[hidden] { display: none; }
  .tabs:not([hidden]) ~ .normas .norma:not([hidden]) { animation: subir 450ms var(--ease) both; }
  @media (max-width: 860px) { .norma { grid-template-columns: 1fr; gap: 12px; padding-block: 24px; } }
  .norma h3 { font-size: var(--step-3); }
  .norma-nombre { margin: 6px 0 0; color: var(--muted); font-size: 0.97rem; }
  .norma-body p { max-width: 64ch; }
  .norma-body .chips { margin: 16px 0 0; }
  .norma-verifica { margin: 16px 0 0; font-size: 0.95rem; color: var(--muted); }
  .norma-verifica strong { color: var(--ink); }
  .nota { margin: 24px 0 0; max-width: 72ch; color: var(--muted); }
  .nota strong { color: var(--ink); }

  /* ---------- Método ---------- */
  .method { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 48px 80px; align-items: start; }
  @media (max-width: 920px) { .method { grid-template-columns: 1fr; } }
  .method-intro h2 { font-size: var(--step-3); margin-bottom: 20px; }
  .method-intro p { max-width: 46ch; }
  .nota-chica { color: var(--muted); font-size: 0.97rem; }
  .method-intro .btn { margin-top: 8px; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; }
  .steps li { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 20px; padding-block: 18px; border-bottom: 1px solid var(--line); }
  .steps li:first-child { padding-top: 0; }
  .steps li:last-child { border-bottom: 0; }
  .step-n {
    width: 44px; height: 44px; border-radius: 50%;
    display: grid; place-items: center;
    background: #fff; border: 1px solid var(--line-strong);
    font-weight: 600; color: var(--primary);
  }
  .steps h3 { font-size: 1.1rem; margin-bottom: 4px; }
  .steps p { margin: 0; color: var(--muted); font-size: 0.97rem; }

  /* ---------- Preguntas frecuentes ---------- */
  .faq-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr); gap: 32px 80px; align-items: start; }
  @media (max-width: 920px) { .faq-grid { grid-template-columns: 1fr; } }
  .faq-intro h2 { font-size: var(--step-3); margin-bottom: 16px; }
  .faq-intro p:not(.eyebrow) { color: var(--muted); }
  .faq { border-top: 1px solid var(--line-strong); }
  .faq details { border-bottom: 1px solid var(--line-strong); }
  .faq summary {
    list-style: none; cursor: pointer;
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; align-items: baseline;
    padding-block: 20px;
    font-weight: 600; font-size: 1.1rem; color: var(--ink); line-height: 1.3;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; font-weight: 400; font-size: 1.5rem; line-height: 1; color: var(--primary); }
  .faq details[open] summary::after { content: '−'; }
  .faq summary:hover { color: var(--primary); }
  .faq-a { margin: 0; padding-bottom: 20px; max-width: 68ch; }
</style>
