---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaDiagnostico from '../../components/CtaDiagnostico.astro';
import { servicios } from '../../data/sitio';

const servicio = servicios.find((s) => s.id === 'alimentaria')!;
const contactoHref = '/contacto?servicio=alimentaria#formulario';

const title = 'Consultoría BPM, ISO 22000 y FSSC 22000 | Procesos Mejores';
const description =
  'Implementamos BPM, ISO 22000 y FSSC 22000 en la industria de alimentos: prerrequisitos, análisis de peligros, auditoría interna y preparación para certificar.';

const perfiles = [
  {
    titulo: 'Plantas elaboradoras de alimentos y bebidas',
    texto: 'Que necesitan ordenar las BPM o dar el paso a un sistema de inocuidad certificado.',
  },
  {
    titulo: 'Fraccionadoras y envasadoras',
    texto: 'Que fraccionan o reenvasan y tienen que demostrar que el proceso no contamina el producto.',
  },
  {
    titulo: 'Depósitos y centros de distribución',
    texto: 'Que tienen que cuidar higiene, temperaturas, control de plagas y trazabilidad.',
  },
  {
    titulo: 'Proveedores de la industria alimentaria',
    texto: 'Cuyos clientes les exigen BPM o una certificación para aprobarlos o seguir comprándoles.',
  },
];

const normas = [
  {
    id: 'bpm',
    sigla: 'BPM',
    nombre: 'Buenas Prácticas de Manufactura',
    tipo: 'El requisito base',
    textos: [
      'Las condiciones de higiene y operación de un establecimiento de alimentos: materias primas, limpieza, personal, plagas, almacenamiento y transporte.',
      'En Argentina las fija el Código Alimentario Argentino. Son el piso que controla la autoridad sanitaria y lo primero que miran los clientes al auditar a un proveedor.',
    ],
    incluye: ['Higiene del personal', 'Limpieza y desinfección (POES)', 'Control de plagas', 'Agua', 'Instalaciones y equipos', 'Almacenamiento y transporte'],
    verifica: 'Inspecciones de la autoridad sanitaria y auditorías de clientes.',
  },
  {
    id: 'iso-22000',
    sigla: 'ISO 22000',
    nombre: 'Sistema de gestión de la inocuidad de los alimentos',
    tipo: 'El sistema de gestión',
    textos: [
      'La norma internacional para gestionar la inocuidad en cualquier eslabón de la cadena alimentaria. Combina prerrequisitos (PRP), los principios del HACCP, la comunicación con proveedores, clientes y autoridades, y la gestión del sistema.',
      'Usa la misma estructura que ISO 9001 e ISO 14001, así que se integra con un sistema que ya tengas.',
    ],
    incluye: ['PRP', 'HACCP', 'Plan de control de peligros', 'Estructura de alto nivel'],
    verifica: 'Auditoría de un organismo de certificación independiente.',
  },
  {
    id: 'fssc-22000',
    sigla: 'FSSC 22000',
    nombre: 'Esquema de certificación de inocuidad alimentaria',
    tipo: 'El reconocimiento internacional',
    textos: [
      'No es otra norma: es un esquema de certificación que toma ISO 22000 completa y le suma prerrequisitos específicos del sector y requisitos propios, como defensa alimentaria, prevención del fraude y gestión de alérgenos.',
      'Está reconocido por GFSI (Global Food Safety Initiative), que es lo que muchas cadenas de supermercados y marcas grandes piden a sus proveedores.',
    ],
    incluye: ['ISO 22000', 'PRP del sector', 'Requisitos adicionales FSSC', 'Reconocido por GFSI'],
    verifica: 'Auditoría de un organismo de certificación licenciado por la Foundation FSSC.',
  },
];

const camino = [
  { sigla: 'BPM', titulo: 'El piso', texto: 'Ordena la higiene y la operación. Sin esta base, nada de lo que sigue se sostiene.' },
  { sigla: 'ISO 22000', titulo: 'El sistema', texto: 'Suma el análisis de peligros, el plan de control y la gestión del sistema.' },
  { sigla: 'FSSC 22000', titulo: 'El reconocimiento', texto: 'Suma los requisitos del sector y del esquema, para los clientes que exigen GFSI.' },
];

const entregables = [
  { titulo: 'Un diagnóstico claro', texto: 'Dónde estás, qué falta y en qué orden conviene resolverlo.' },
  { titulo: 'Prerrequisitos funcionando', texto: 'Limpieza, plagas, agua, higiene, mantenimiento y proveedores, aplicados en la planta.' },
  { titulo: 'Análisis de peligros y plan de control', texto: 'Peligros evaluados, con sus controles, límites, monitoreo y acciones ante desvíos.' },
  { titulo: 'Documentación que se usa', texto: 'Registros pensados para completarse en la línea, no para llenar una carpeta.' },
  { titulo: 'Un equipo que sabe', texto: 'Personal capacitado en BPM y un equipo de inocuidad que puede sostener el sistema.' },
  { titulo: 'Un sistema auditado', texto: 'Auditoría interna completa antes que la del organismo, con los hallazgos tratados.' },
];

const etapas = [
  { titulo: 'Relevamiento en planta', texto: 'Recorremos la planta y revisamos lo que ya tenés. Sale un informe de brechas con prioridades.' },
  { titulo: 'Programas de prerrequisitos', texto: 'Ordenamos la base: instalaciones, limpieza, plagas, agua, higiene, mantenimiento y proveedores.' },
  { titulo: 'Análisis de peligros', texto: 'Con el equipo de inocuidad: diagramas de flujo, peligros biológicos, químicos y físicos, y sus controles.' },
  { titulo: 'Documentación y registros', texto: 'Construidos con la gente que los va a usar. Trazabilidad y retiro de producto, probados.' },
  { titulo: 'Capacitación del personal', texto: 'BPM para la línea y formación del equipo de inocuidad y de la dirección, en el camino.' },
  { titulo: 'Auditoría interna', texto: 'Auditamos el sistema completo antes que el organismo y formamos a tus auditores internos.' },
  { titulo: 'Preparación para la certificación', texto: 'Acompañamos la auditoría externa y el tratamiento de los hallazgos.' },
];

const pageUrl = new URL('/servicios/inocuidad-alimentaria', Astro.site).href;
const siteUrl = new URL('/', Astro.site).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Consultoría en inocuidad alimentaria: BPM, ISO 22000 y FSSC 22000',
    serviceType: 'Consultoría en sistemas de gestión de inocuidad alimentaria',
    description,
    url: pageUrl,
    provider: {
      '@type': 'ProfessionalService',
      name: 'Procesos Mejores',
      url: siteUrl,
    },
    areaServed: { '@type': 'Country', name: 'Argentina' },
    audience: {
      '@type': 'BusinessAudience',
      audienceType: 'Plantas elaboradoras, fraccionadoras, depósitos y proveedores de la industria de alimentos y bebidas',
    },
    about: servicio.normas.map((n) => ({ '@type': 'Thing', name: n })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Servicios', item: new URL('/#servicios', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: servicio.nombre, item: pageUrl },
    ],
  },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <!-- A CONFIRMAR: que el acompañamiento llegue hasta la auditoría de certificación (bajada de la cabecera). -->
  <PageHeader
    eyebrow="Industria de alimentos y bebidas"
    ilustracion="alimentaria"
    title="Inocuidad alimentaria: BPM, ISO 22000 y FSSC 22000"
    lead="Trabajamos en planta, con tu equipo, desde el primer relevamiento hasta la auditoría de certificación."
    crumbs={[{ label: 'Servicios', href: '/#servicios' }, { label: servicio.nombre }]}
  >
    <a class="btn btn--primary" href={contactoHref}>Solicitar diagnóstico inicial</a>
    <a class="btn btn--ghost" href="#normas">Ver las normas</a>
  </PageHeader>

  <!-- ============ PARA QUIÉN ES ============ -->
  <section class="section">
    <div class="wrap split">
      <div class="split-intro">
        <p class="eyebrow">Para quién es</p>
        <h2>Para empresas a las que un cliente les empezó a pedir más.</h2>
        <p>Un cliente, una cadena o un mercado nuevo pide BPM o una certificación, y hay que ordenar la planta para cumplir.</p>
        <a class="link-arrow" href={contactoHref}>Contanos qué te pidieron</a>
      </div>
      <ul class="rows">
        {perfiles.map((p) => (
          <li>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ LAS NORMAS ============ -->
  <section class="section section--soft" id="normas" aria-labelledby="normas-titulo">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Normas alimentarias</p>
        <h2 id="normas-titulo">BPM, ISO 22000 y FSSC 22000: qué es cada una.</h2>
        <p>Se nombran juntas, pero no son lo mismo: un requisito base, un sistema de gestión y un esquema de certificación.</p>
      </div>

      <!-- Pestañas: el script de abajo las muestra. Sin JavaScript se ven las tres normas una abajo de la otra. -->
      <div class="tabs" role="tablist" aria-label="Normas alimentarias" hidden>
        {normas.map((n, i) => (
          <button type="button" role="tab" id={`tab-${n.id}`} aria-controls={n.id} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            <span>{n.tipo}</span>{n.sigla}
          </button>
        ))}
      </div>

      <ul class="normas">
        {normas.map((n) => (
          <li class="norma" id={n.id}>
            <div class="norma-name">
              <p class="norma-tipo">{n.tipo}</p>
              <h3>{n.sigla}</h3>
              <p class="norma-nombre">{n.nombre}</p>
            </div>
            <div class="norma-body">
              {n.textos.map((t) => <p>{t}</p>)}
              <ul class="chips" aria-label={`Qué incluye ${n.sigla}`}>
                {n.incluye.map((i) => <li class="chip">{i}</li>)}
              </ul>
              <p class="norma-verifica"><strong>Cómo se verifica:</strong> {n.verifica}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ EL CAMINO ============ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">El camino habitual</p>
        <h2>De las BPM a la certificación, paso a paso.</h2>
        <p>No compiten: cada una se apoya en la anterior, y lo que hacés para una sirve para la siguiente.</p>
      </div>

      <ol class="path">
        {camino.map((c, i) => (
          <li>
            <p class="path-n">Etapa {i + 1}</p>
            <h3>{c.sigla} · {c.titulo}</h3>
            <p>{c.texto}</p>
          </li>
        ))}
      </ol>

      <p class="path-note">
        <strong>No hace falta recorrer las tres.</strong> A algunas empresas les alcanza con las BPM; otras,
        con las BPM consolidadas, van directo a FSSC 22000. Hasta dónde llegar depende de lo que te piden tus
        clientes y de dónde parte tu planta.
      </p>
    </div>
  </section>

  <!-- ============ QUÉ TE LLEVÁS ============ -->
  <section class="section section--soft">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Qué te llevás</p>
        <h2>Una planta ordenada y un equipo que sabe sostenerla.</h2>
      </div>
      <ul class="gets">
        {entregables.map((e) => (
          <li>
            <h3>{e.titulo}</h3>
            <p>{e.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ CÓMO TRABAJAMOS ============ -->
  <section class="section">
    <div class="wrap method">
      <div class="method-intro">
        <p class="eyebrow">Cómo trabajamos</p>
        <h2>En la planta, con la gente que produce.</h2>
        <p>
          La inocuidad no se resuelve en una oficina. Trabajamos con quienes limpian, producen, reciben y
          despachan, porque son quienes después sostienen el sistema.
        </p>
        <!-- A CONFIRMAR: si Rodrigo tiene experiencia previa en ISO 22000 y FSSC 22000 (el sitio anterior no lo dice). Si la confirma, puede volver «Tenemos experiencia en ISO 22000 y FSSC 22000, y también en ISO 9001, ISO 14001 e ISO 45001.» -->
        <p>
          Además de ISO 22000 y FSSC 22000, trabajamos con ISO 9001, ISO 14001 e ISO 45001.
          Si ya tenés otro sistema certificado, lo integramos en lugar de sumar papeles.
        </p>
        <a class="btn btn--primary" href={contactoHref}>Empezar por un diagnóstico</a>
      </div>
      <ol class="steps">
        {etapas.map((e, i) => (
          <li>
            <span class="step-n" aria-hidden="true">{i + 1}</span>
            <div>
              <h3>{e.titulo}</h3>
              <p>{e.texto}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ PREGUNTAS FRECUENTES ============ -->
  <section class="section section--soft" aria-labelledby="faq-titulo">
    <div class="wrap faq-grid">
      <div class="faq-intro">
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2 id="faq-titulo">Lo que más nos preguntan.</h2>
        <p>¿Tenés otra duda? <a href={contactoHref}>Escribinos</a> y te respondemos.</p>
      </div>

      <div class="faq">
        <details>
          <summary>¿Cuál es la diferencia entre ISO 22000 y FSSC 22000?</summary>
          <div class="faq-a">
            <p>
              FSSC 22000 incluye ISO 22000 y le suma requisitos del sector y del esquema; por eso está reconocida
              por GFSI, e ISO 22000 sola no. Si tu cliente exige GFSI, ISO 22000 no alcanza. Si no, puede ser
              suficiente, y deja hecha buena parte del camino.
            </p>
          </div>
        </details>

        <details>
          <summary>¿Necesito tener BPM antes de ir por ISO 22000?</summary>
          <div class="faq-a">
            <p>
              Sí. ISO 22000 exige prerrequisitos, y las BPM son esa base. Además no son opcionales: las establece
              el Código Alimentario Argentino. Si ya las tenés, verificamos cómo funcionan y seguimos desde ahí.
            </p>
          </div>
        </details>

        <details>
          <summary>¿Quién certifica?</summary>
          <div class="faq-a">
            <p>
              Un organismo independiente que elegís vos; para FSSC 22000, licenciado por la Foundation FSSC.
              Nosotros no certificamos: quien implementa no puede certificar. Te preparamos y te acompañamos en la
              auditoría. Las BPM las controlan la autoridad sanitaria y, muchas veces, tus clientes.
            </p>
          </div>
        </details>

        <details>
          <summary>¿Se puede integrar con ISO 9001 u otro sistema que ya tengo?</summary>
          <div class="faq-a">
            <p>
              Sí. ISO 22000 comparte estructura con ISO 9001, ISO 14001 e ISO 45001, así que se puede gestionar todo
              en un solo sistema. Mirá los <a href="/servicios/sistemas-de-gestion-iso">sistemas de gestión ISO</a>.
            </p>
          </div>
        </details>

        <details>
          <summary>¿Cuánto tiempo lleva?</summary>
          <div class="faq-a">
            <!-- A CONFIRMAR: si Rodrigo quiere dar rangos de duración orientativos para BPM, ISO 22000 y FSSC 22000. -->
            <p>
              Depende del punto de partida, del tamaño, de los productos y de la norma elegida. Los plazos quedan
              escritos en el plan de trabajo antes de empezar.
            </p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <CtaDiagnostico
    servicio="alimentaria"
    title="¿Te pidieron BPM o una certificación? Empecemos por un diagnóstico."
    text="Recorremos tu planta, vemos qué te piden tus clientes o la ley y te decimos qué hace falta, en qué orden y cuánto trabajo lleva."
  />
</Base>

<script>
  // Pestañas de las tres normas. Se activan sólo con JavaScript; las flechas del teclado
  // también cambian de pestaña, y un enlace a #bpm, #iso-22000 o #fssc-22000 abre la que corresponde.
  const lista = document.querySelector<HTMLElement>('.tabs');
  if (lista) {
    const tabs = Array.from(lista.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const paneles = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);
    lista.hidden = false;
    paneles[0].parentElement!.setAttribute('role', 'presentation');
    paneles.forEach((p, i) => {
      p.setAttribute('role', 'tabpanel');
      p.setAttribute('aria-labelledby', tabs[i].id);
      p.tabIndex = 0;
    });
    const mostrar = (i: number, foco = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(i === j));
        t.tabIndex = i === j ? 0 : -1;
        paneles[j].hidden = i !== j;
      });
      if (foco) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => mostrar(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') mostrar((i + 1) % tabs.length, true);
        if (e.key === 'ArrowLeft') mostrar((i - 1 + tabs.length) % tabs.length, true);
      });
    });
    const desdeEnlace = paneles.findIndex((p) => `#${p.id}` === location.hash);
    mostrar(desdeEnlace >= 0 ? desdeEnlace : 0);
  }
</script>

<style>
  /* ---------- Pestañas de normas ---------- */
  .tabs { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 8px; }
  .tabs[hidden] { display: none; }
  .tabs button {
    flex: 1 1 200px; display: grid; gap: 4px; text-align: left; cursor: pointer;
    padding: 16px 20px; font: inherit; font-size: var(--step-1); font-weight: 700; line-height: 1.2;
    color: var(--ink); background: var(--white);
    border: 1px solid var(--line-strong); border-radius: var(--radius);
    transition: background-color var(--base) var(--ease), border-color var(--base) var(--ease), color var(--base) var(--ease);
  }
  .tabs button span {
    font-size: var(--step--2); letter-spacing: 0.085em; text-transform: uppercase; color: var(--muted);
    transition: color var(--base) var(--ease);
  }
  .tabs button:hover { border-color: var(--primary); }
  .tabs button[aria-selected='true'] { background: var(--primary); border-color: var(--primary); color: var(--white); }
  .tabs button[aria-selected='true'] span { color: rgba(255, 255, 255, 0.82); }
  .tabs:not([hidden]) ~ .normas .norma:not([hidden]) { animation: subir 450ms var(--ease) both; }
  .tabs:not([hidden]) ~ .normas .norma-tipo { display: none; }
  .norma[hidden] { display: none; }
  @media (max-width: 560px) {
    .tabs { gap: 6px; }
    .tabs button { flex: 1 1 0; padding: 12px 8px; font-size: 0.95rem; text-align: center; }
    .tabs button span { display: none; }
  }

  /* ---------- Para quién ---------- */
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 40px 80px; align-items: start; }
  @media (max-width: 920px) { .split { grid-template-columns: 1fr; } }
  .split-intro h2 { font-size: var(--step-3); margin-bottom: 20px; }
  .split-intro p:not(.eyebrow) { color: var(--text); max-width: 48ch; }

  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .rows li { padding-block: 22px; border-bottom: 1px solid var(--line); }
  .rows h3 { font-size: 1.1rem; margin-bottom: 6px; }
  .rows p { margin: 0; color: var(--muted); }

  /* ---------- Normas ---------- */
  .normas { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  .norma {
    display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr); gap: 16px 64px;
    padding-block: 36px; border-bottom: 1px solid var(--line-strong);
    scroll-margin-top: 88px;
  }
  @media (max-width: 860px) { .norma { grid-template-columns: 1fr; gap: 16px; padding-block: 28px; } }
  .norma-tipo {
    font-family: var(--font-display); font-size: 0.78rem; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted);
    margin: 0 0 10px; padding-left: 12px; border-left: 2px solid var(--brand);
  }
  .norma h3 { font-size: var(--step-3); }
  .norma-nombre { margin: 8px 0 0; color: var(--muted); font-size: 0.97rem; max-width: 28ch; }
  .norma-body p { max-width: 68ch; }
  .norma-body .chips { margin: 20px 0 0; }
  .norma-verifica { margin: 18px 0 0; padding-top: 16px; border-top: 1px solid var(--line); font-size: 0.95rem; color: var(--muted); }
  .norma-verifica strong { color: var(--ink); font-weight: 600; }

  /* ---------- Camino ---------- */
  .path { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .path li { position: relative; padding-top: 28px; border-top: 1px solid var(--line-strong); }
  .path li::before {
    content: ''; position: absolute; top: -5px; left: 0;
    width: 9px; height: 9px; border-radius: 50%; background: var(--primary);
  }
  .path-n {
    font-family: var(--font-display); font-size: 0.78rem; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin: 0 0 8px;
  }
  .path h3 { font-size: var(--step-1); margin-bottom: 10px; }
  .path li p:last-child { margin: 0; color: var(--muted); }
  @media (max-width: 860px) {
    .path { grid-template-columns: 1fr; gap: 0; border-left: 1px solid var(--line-strong); margin-left: 4px; }
    .path li { border-top: 0; padding: 0 0 28px 24px; }
    .path li:last-child { padding-bottom: 0; }
    .path li::before { top: 6px; left: -5px; }
  }
  .path-note {
    margin: clamp(32px, 4vw, 48px) 0 0; padding-top: 24px; border-top: 1px solid var(--line);
    max-width: 72ch; color: var(--text);
  }

  /* ---------- Qué te llevás ---------- */
  .gets { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 40px; }
  @media (max-width: 980px) { .gets { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .gets { grid-template-columns: 1fr; } }
  .gets li { padding-block: 24px; border-top: 1px solid var(--line-strong); }
  .gets h3 { font-size: 1.1rem; margin-bottom: 6px; }
  .gets p { margin: 0; color: var(--muted); }

  /* ---------- Método ---------- */
  .method { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 48px 80px; align-items: start; }
  @media (max-width: 920px) { .method { grid-template-columns: 1fr; } }
  .method-intro h2 { font-size: var(--step-3); margin-bottom: 20px; }
