---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import fotoIso from '../../assets/fotos/iso.webp';
import CtaDiagnostico from '../../components/CtaDiagnostico.astro';
import { servicios, pasos } from '../../data/sitio';
import { obtenerCursos } from '../../lib/cursos';

const servicio = servicios.find((s) => s.id === 'iso')!;
const consultar = '/contacto?servicio=iso#formulario';
const sitio = 'https://www.procesosmejores.com';
const url = `${sitio}${servicio.href}`;

// Títulos reales de los cursos relacionados (salen de src/content/cursos).
const cursos = new Map(obtenerCursos().map((c) => [c.slug, c]));

const normas = [
  { codigo: 'ISO 9001', tema: 'Gestión de la calidad', que: 'Procesos claros para entregar siempre lo que el cliente pide. La base de muchas otras.', curso: 'iso-9001' },
  { codigo: 'ISO 14001', tema: 'Gestión ambiental', que: 'Aspectos ambientales y obligaciones legales bajo control. Nueva edición en 2026.', curso: 'iso-14001-2026' },
  { codigo: 'ISO 45001', tema: 'Seguridad y salud en el trabajo', que: 'Prevenir lesiones y enfermedades laborales. Reemplazó a OHSAS 18001.', curso: 'iso-45001' },
  { codigo: 'ISO 50001', tema: 'Gestión de la energía', que: 'Medir y mejorar el uso de la energía.', curso: '' },
  { codigo: 'ISO 21001', tema: 'Organizaciones educativas', que: 'Sistemas de gestión para escuelas, institutos y áreas de capacitación.', curso: '' },
];

const entregables = [
  'Un diagnóstico con brechas y prioridades.',
  'Procesos y documentación a medida, no una plantilla.',
  'Riesgos y requisitos legales identificados.',
  'Auditores internos formados en tu equipo.',
  'El sistema listo para la auditoría de certificación.',
];

const faqs = [
  {
    q: '¿Ustedes certifican?',
    a: 'No. Certifica un organismo independiente; quien asesora no puede certificar a la misma organización. Nosotros te preparamos y estamos con tu equipo en la auditoría.',
  },
  {
    q: '¿Sirve para una pyme?',
    a: 'Sí. Los requisitos son los mismos para cualquier tamaño; cambia cómo se cumplen. En una pyme el sistema suele ser más simple.',
  },
  {
    q: 'Ya tenemos ISO 9001. ¿Podemos sumar otra norma?',
    a: 'Sí, y conviene integrarlas: comparten estructura, así que documentación, auditorías y revisión por la dirección sirven para todas. Los certificadores pueden ofrecer auditorías integradas, con honorarios menores.',
  },
  {
    q: '¿Qué pasa después de certificar?',
    a: 'El certificado dura tres años, con auditorías de seguimiento, normalmente anuales. Podemos acompañar el mantenimiento y las actualizaciones de la norma.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Sistemas de gestión ISO',
    serviceType: 'Consultoría en sistemas de gestión ISO',
    description:
      'Implementación, mantenimiento y auditoría de sistemas de gestión ISO 9001, ISO 14001, ISO 45001, ISO 50001 e ISO 21001, con foco en la gestión de riesgos y el cumplimiento normativo.',
    url,
    areaServed: 'AR',
    provider: { '@type': 'ProfessionalService', name: 'Procesos Mejores', url: `${sitio}/` },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Normas de sistemas de gestión',
      itemListElement: normas.map((n) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: `${n.codigo}: ${n.tema.toLowerCase()}`, description: n.que },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${sitio}/` },
      { '@type': 'ListItem', position: 2, name: 'Servicios', item: `${sitio}/#servicios` },
      { '@type': 'ListItem', position: 3, name: servicio.nombre, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Base
  title="Consultoría ISO 9001, 14001, 45001 y 50001 | Procesos Mejores"
  description="Implementación, mantenimiento y auditoría de sistemas de gestión ISO 9001, 14001, 45001, 50001 y 21001. Gestión de riesgos y cumplimiento normativo."
  jsonLd={jsonLd}
>
  <!-- A CONFIRMAR: que el acompañamiento llegue hasta la auditoría de certificación (bajada de la cabecera). -->
  <PageHeader
    eyebrow="Consultoría"
    ilustracion="iso"
    foto={fotoIso}
    fotoAlt="Equipo de trabajo revisando un mapa de procesos sobre una mesa, junto a la planta"
    title="Sistemas de gestión ISO"
    lead="Calidad, ambiente, seguridad y salud en el trabajo, energía y educación. Te acompañamos con tu equipo, desde el diagnóstico hasta la auditoría de certificación."
    crumbs={[{ label: 'Servicios', href: '/#servicios' }, { label: servicio.nombre }]}
  >
    <a class="btn btn--primary" href={consultar}>Solicitar diagnóstico inicial</a>
    <a class="btn btn--ghost btn--white" href="/cursos">Ver cursos</a>
  </PageHeader>

  <!-- ============ NORMAS ============ -->
  <section class="section" id="normas">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Normas</p>
        <h2>Las normas con las que trabajamos.</h2>
        <p>Solas o integradas en un mismo sistema. Si no sabés cuál necesitás, lo vemos en el diagnóstico.</p>
      </div>

      <ul class="normas">
        {normas.map((n) => {
          const curso = n.curso ? cursos.get(n.curso) : undefined;
          return (
            <li class="norma">
              <h3>
                <span class="norma-codigo">{n.codigo}</span>
                <span class="norma-tema">{n.tema}</span>
              </h3>
              <p>{n.que}</p>
              <div class="norma-acciones">
                <a class="link-arrow" href={consultar} aria-label={`Consultar por ${n.codigo}`}>Consultar</a>
                {curso && <a class="norma-curso" href={`/cursos#${curso.slug}`}>Curso de auditor interno</a>}
              </div>
            </li>
          );
        })}
      </ul>

      <p class="otras">
        ¿Seguridad de la información? Mirá <a href="/servicios/vciso">vCISO</a>.
        ¿Alimentos? Mirá <a href="/servicios/inocuidad-alimentaria">Inocuidad alimentaria</a>.
      </p>
    </div>
  </section>

  <!-- ============ QUÉ TE LLEVÁS ============ -->
  <section class="section section--soft">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Qué te llevás</p>
        <h2>Un sistema que tu equipo entiende y sostiene.</h2>
        <!-- A CONFIRMAR: si Rodrigo quiere dar un rango orientativo de duración (por ejemplo, para una pyme que parte de cero con una sola norma). Mientras tanto, redacción neutra. -->
        <p class="nota">Los plazos dependen del tamaño, del alcance y del punto de partida. Se acuerdan en el diagnóstico.</p>
      </div>
      <ul class="lista">
        {entregables.map((e) => <li>{e}</li>)}
      </ul>
    </div>
  </section>

  <!-- ============ CÓMO TRABAJAMOS ============ -->
  <section class="section">
    <div class="wrap method">
      <div class="method-intro">
        <p class="eyebrow">Cómo trabajamos</p>
        <h2>Con tu equipo, no para tu equipo.</h2>
        <p>Quienes van a sostener el sistema participan desde el diagnóstico y se forman como auditores internos.</p>
      </div>
      <ol class="steps">
        {pasos.map((p, i) => (
          <li>
            <span class="step-n" aria-hidden="true">{i + 1}</span>
            <div>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ PREGUNTAS FRECUENTES ============ -->
  <section class="section section--soft" id="preguntas">
    <div class="wrap faq">
      <div class="faq-head">
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2>Antes de empezar.</h2>
        <p>¿Otra duda? <a href={consultar}>Contanos tu caso</a>.</p>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p class="faq-answer">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaDiagnostico servicio="iso" />
</Base>

<style>
  .btn--white { background: var(--white); }

  /* ---------- Normas ---------- */
  .normas { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  .norma {
    display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.5fr) 15rem; gap: 10px 40px;
    align-items: center; padding-block: 22px; border-bottom: 1px solid var(--line-strong);
    transition: background-color var(--base) var(--ease);
  }
  @media (hover: hover) { .norma:hover { background: var(--paper); } }
  @media (max-width: 860px) { .norma { grid-template-columns: 1fr; gap: 8px; } }
  .norma h3 { display: grid; gap: 2px; }
  .norma-codigo { font-size: var(--step-2); letter-spacing: -0.02em; }
  .norma-tema { font-size: 0.97rem; font-weight: 400; color: var(--muted); letter-spacing: 0; }
  .norma > p { margin: 0; }
  .norma-acciones { display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: 8px 20px; }
  @media (max-width: 860px) { .norma-acciones { justify-content: flex-start; } }
  .norma-curso { font-size: 0.9rem; }
  .otras { margin: 28px 0 0; color: var(--muted); }

  /* ---------- Qué te llevás ---------- */
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 32px 80px; align-items: start; }
  @media (max-width: 920px) { .split { grid-template-columns: 1fr; } }
  .split h2 { font-size: var(--step-3); margin-bottom: 16px; }
  .nota { color: var(--muted); max-width: 46ch; margin: 0; }
  .lista { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  .lista li { position: relative; padding: 16px 0 16px 28px; border-bottom: 1px solid var(--line); }
  .lista li::before {
    content: ''; position: absolute; left: 2px; top: 1.45em; width: 12px; height: 7px;
    border-left: 2px solid var(--primary); border-bottom: 2px solid var(--primary); transform: rotate(-45deg);
  }

  /* ---------- Método ---------- */
  .method { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 48px 80px; align-items: start; }
  @media (max-width: 920px) { .method { grid-template-columns: 1fr; } }
  .method-intro h2 { font-size: var(--step-3); margin-bottom: 20px; }
  .method-intro p { max-width: 46ch; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; }
  .steps li { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 20px; padding-block: 20px; border-bottom: 1px solid var(--line); }
  .steps li:first-child { padding-top: 0; }
  .steps li:last-child { border-bottom: 0; }
  .step-n {
    width: 44px; height: 44px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--white); border: 1px solid var(--line-strong);
    font-weight: 600; color: var(--primary);
  }
  .steps h3 { font-size: 1.1rem; margin-bottom: 4px; }
  .steps p { margin: 0; color: var(--muted); font-size: 0.97rem; }

  /* ---------- Preguntas frecuentes ---------- */
  .faq { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: 32px 80px; align-items: start; }
  @media (max-width: 920px) { .faq { grid-template-columns: 1fr; } }
  .faq-head h2 { font-size: var(--step-3); margin-bottom: 16px; }
  .faq-head p:last-child { color: var(--muted); }
  .faq-list { border-top: 1px solid var(--line-strong); }
  details { border-bottom: 1px solid var(--line-strong); }
  summary {
    list-style: none; cursor: pointer;
    display: grid; grid-template-columns: minmax(0, 1fr) 20px; gap: 16px; align-items: center;
    padding-block: 20px;
    font-weight: 600; font-size: 1.1rem; color: var(--ink); line-height: 1.3;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; justify-self: end; font-weight: 400; font-size: 1.5rem; line-height: 1; color: var(--primary); }
  details[open] summary::after { content: '\2212'; }
  summary:hover { color: var(--primary); }
  .faq-answer { margin: 0; padding-bottom: 20px; max-width: 64ch; }
</style>
