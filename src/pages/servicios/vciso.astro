---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import fotoVciso from '../../assets/fotos/vciso.webp';
import ContactForm from '../../components/ContactForm.astro';
import { contacto } from '../../data/sitio';

const inicio = new URL('/', Astro.site).href;
const url = new URL('/servicios/vciso', Astro.site).href;

const titulo = 'vCISO: seguridad de la información e ISO/IEC 27001 | Procesos Mejores';
const descripcion =
  'Un responsable externo de seguridad de la información, unas horas por mes: riesgos, políticas, ISO/IEC 27001, cuestionarios de clientes y Ley 25.326.';

// Cuándo suele aparecer la necesidad en una pyme.
const disparadores = [
  { titulo: 'Un cliente te manda un cuestionario de seguridad', texto: 'O exige ISO/IEC 27001 en el contrato.' },
  { titulo: 'La aseguradora pide controles mínimos', texto: 'Doble factor, copias de seguridad, accesos.' },
  { titulo: 'Tu empresa maneja datos personales', texto: 'La Ley 25.326 obliga a protegerlos.' },
];

// Qué incluye el acompañamiento.
const incluye = [
  { titulo: 'Análisis de riesgos', texto: 'Qué información es crítica y qué puede fallar.' },
  { titulo: 'Política y documentación', texto: 'Reglas claras y registros a medida, sin carpetas de más.' },
  { titulo: 'Controles de ISO/IEC 27001', texto: 'Cuáles aplican, con responsable y evidencia.' },
  { titulo: 'Cuestionarios de clientes', texto: 'Los respondemos con tu equipo, con la evidencia ordenada.' },
  { titulo: 'Reporte a la dirección', texto: 'Riesgos, avance y decisiones pendientes, en lenguaje de negocio.' },
  { titulo: 'Concientización', texto: 'Para reconocer un phishing y saber a quién avisar.' },
];

// Quién hace qué en la seguridad de la información de la empresa.
const roles = [
  { quien: 'La dirección', verbo: 'Decide', texto: 'Aprueba la política y cuánto riesgo acepta.' },
  { quien: 'El vCISO', verbo: 'Gobierna', texto: 'Analiza riesgos, arma el plan, coordina y reporta.', nosotros: true },
  { quien: 'Sistemas o tu proveedor', verbo: 'Opera', texto: 'Configura y administra la tecnología.' },
  { quien: 'Auditoría interna', verbo: 'Verifica', texto: 'Gente de tu equipo formada, o un auditor externo.' },
  { quien: 'Organismo certificador', verbo: 'Certifica', texto: 'Si decidís certificar, audita y emite el certificado.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'vCISO: responsable externo de seguridad de la información',
    serviceType: 'vCISO (CISO virtual)',
    description: descripcion,
    url,
    areaServed: { '@type': 'Country', name: 'Argentina' },
    provider: {
      '@type': 'ProfessionalService',
      name: 'Procesos Mejores',
      url: inicio,
      foundingDate: '2012',
    },
    about: ['ISO/IEC 27001', 'Gestión de riesgos de seguridad de la información', 'Ley 25.326'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: inicio },
      { '@type': 'ListItem', position: 2, name: 'Servicios', item: `${inicio}#servicios` },
      { '@type': 'ListItem', position: 3, name: 'vCISO', item: url },
    ],
  },
];
---
<Base title={titulo} description={descripcion} jsonLd={jsonLd}>
  <PageHeader
    eyebrow="Seguridad de la información · ISO/IEC 27001"
    ilustracion="vciso"
    foto={fotoVciso}
    fotoAlt="Reunión de trabajo frente a una notebook con un tablero de indicadores"
    title="vCISO, tu responsable externo de seguridad de la información."
    lead="Alguien que se hace cargo de la seguridad de la información de tu empresa: ordena los riesgos, fija prioridades y le reporta a la dirección. Con dedicación parcial."
    crumbs={[{ label: 'Servicios', href: '/#servicios' }, { label: 'vCISO' }]}
  >
    <a class="btn btn--primary" href="#formulario-vciso">Solicitar diagnóstico inicial</a>
    <a class="btn btn--ghost btn--white" href="#incluye">Ver qué incluye</a>
  </PageHeader>

  <!-- ============ CUÁNDO HACE FALTA ============ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Cuándo hace falta</p>
        <h2>Cuando alguien te empieza a preguntar por la seguridad.</h2>
      </div>
      <!-- A CONFIRMAR: antes decía que «los informes de la industria ubican a Argentina entre los países más atacados de la región, y la mayoría de los ataques apunta a pymes». Se sacó por no tener fuente; si se consigue el informe (nombre y año), se puede volver a poner citándolo. -->
      <ul class="tiles tiles--3">
        {disparadores.map((d) => (
          <li>
            <h3>{d.titulo}</h3>
            <p>{d.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ QUÉ INCLUYE ============ -->
  <section class="section section--soft" id="incluye">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Qué incluye</p>
        <h2>Lo que pide ISO/IEC 27001, sostenido mes a mes.</h2>
      </div>
      <ul class="tiles">
        {incluye.map((item) => (
          <li>
            <h3>{item.titulo}</h3>
            <p>{item.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ QUIÉN HACE QUÉ ============ -->
  <section class="section" id="roles">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Quién hace qué</p>
        <h2>Cada uno en su lugar. Así nadie se controla a sí mismo.</h2>
      </div>

      <ol class="roles">
        {roles.map((r) => (
          <li class:list={['rol', { 'rol--nosotros': r.nosotros }]}>
            <p class="rol-verbo">{r.verbo}</p>
            <h3>{r.quien}{r.nosotros && <span class="rol-tag">Nosotros</span>}</h3>
            <p>{r.texto}</p>
          </li>
        ))}
      </ol>

      <div class="limits">
        <p>
          <strong>Por qué no auditamos ni certificamos.</strong> Si armamos el sistema, revisarlo nosotros sería
          controlar nuestro propio trabajo. Lo dejamos por escrito en la propuesta.
        </p>
        <!-- A CONFIRMAR: si hay un socio técnico para estos servicios. Antes decía «los coordinamos con socios técnicos especializados»; se sacó por no estar confirmado. -->
        <p>
          <strong>Qué no incluye.</strong> Tests de intrusión, monitoreo 24/7 ni respuesta técnica a incidentes:
          el vCISO gobierna, no opera.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ CÓMO SE CONTRATA ============ -->
  <section class="section section--soft">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Cómo se contrata</p>
        <h2>Diagnóstico primero, acompañamiento después.</h2>
      </div>
      <!-- A CONFIRMAR: duración típica del diagnóstico inicial, y horizonte del plan (antes decía «plan a 12 meses», sin fuente). -->
      <ol class="fases">
        <li>
          <span class="step-n" aria-hidden="true">1</span>
          <div>
            <h3>Diagnóstico inicial</h3>
            <p>Vemos cómo se maneja hoy la información y qué te piden. Sale un plan con prioridades.</p>
          </div>
        </li>
        <li>
          <span class="step-n" aria-hidden="true">2</span>
          <div>
            <h3>Acompañamiento mensual</h3>
            <p>Unas horas por mes, según lo que salga del diagnóstico. Se revisa con la dirección.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ============ PREGUNTAS FRECUENTES ============ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Dudas habituales</p>
        <h2>Preguntas frecuentes</h2>
      </div>

      <div class="faq">
        <details>
          <summary>¿Qué diferencia hay con un CISO interno?</summary>
          <p class="answer">El rol es el mismo; cambia la dedicación. Y aunque el acompañamiento sea continuo, el conocimiento queda en tu gente.</p>
        </details>
        <details>
          <summary>¿Cuántas horas por mes hacen falta?</summary>
          <!-- A CONFIRMAR: si se quiere publicar un rango orientativo de horas mensuales. -->
          <p class="answer">Se define en el diagnóstico, según el tamaño de la empresa y lo que le piden clientes, aseguradora o ley.</p>
        </details>
        <details>
          <summary>¿Necesito certificar ISO/IEC 27001?</summary>
          <p class="answer">No. Es el marco de trabajo. Si un contrato exige certificar, el trabajo apunta a esa auditoría.</p>
        </details>
        <details>
          <summary>¿Pueden formar a nuestros auditores internos?</summary>
          <p class="answer">Sí, con el <a href="/cursos#iso-27001">curso de auditor interno ISO/IEC 27001</a>.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- ============ FORMULARIO ============ -->
  <section class="section section--soft" id="formulario-vciso">
    <div class="wrap contact">
      <div class="contact-intro">
        <p class="eyebrow">Contacto</p>
        <h2>Contanos qué te están pidiendo.</h2>
        <p>Con eso coordinamos una primera conversación.</p>
        <div class="contact-direct">
          <p>¿Preferís escribirnos directo?</p>
          <a href={`mailto:${contacto.email}`}>{contacto.email}</a>
          <a href={contacto.telefonoLink}>{contacto.telefono}</a>
          <a class="link-arrow" href={contacto.whatsapp} target="_blank" rel="noopener">Escribir por WhatsApp</a>
        </div>
      </div>

      <div class="form-panel">
        <ContactForm servicio="vciso" />
      </div>
    </div>
  </section>
</Base>

<style>
  .btn--white { background: var(--white); }

  /* ---------- Tarjetas de una línea ---------- */
  .tiles {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr)); gap: 12px;
  }
  .tiles--3 { grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); }
  .tiles li {
    padding: 22px; background: var(--white);
    border: 1px solid var(--line-strong); border-radius: var(--radius);
    transition: border-color var(--base) var(--ease), transform var(--base) var(--ease);
  }
  @media (hover: hover) { .tiles li:hover { border-color: var(--primary); transform: translateY(-3px); } }
  .tiles h3 { font-size: 1.1rem; margin-bottom: 4px; }
  .tiles p { margin: 0; color: var(--muted); font-size: 0.95rem; line-height: 1.45; }

  /* ---------- Quién hace qué ---------- */
  .roles {
    list-style: none; margin: 0 0 32px; padding: 0;
    display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px;
  }
  .rol {
    padding: 22px 20px; background: var(--white);
    border: 1px solid var(--line-strong); border-radius: var(--radius);
    transition: transform var(--base) var(--ease), border-color var(--base) var(--ease);
  }
  @media (hover: hover) { .rol:hover { transform: translateY(-4px); border-color: var(--primary); } }
  .rol--nosotros { background: var(--primary-soft); border-color: var(--primary); }
  .rol-verbo {
    margin: 0 0 10px; font-size: var(--step--2); font-weight: 700;
    letter-spacing: 0.085em; text-transform: uppercase; color: var(--primary);
  }
  .rol h3 { font-size: 1.1rem; margin-bottom: 8px; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; }
  .rol-tag {
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em; line-height: 1;
    padding: 4px 8px; border-radius: 999px; background: var(--primary); color: var(--white);
  }
  .rol p:last-child { margin: 0; color: var(--muted); font-size: 0.95rem; line-height: 1.5; }
  @media (max-width: 980px) {
    .roles { grid-template-columns: 1fr; gap: 8px; }
    .rol { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 2px 20px; padding: 18px 20px; }
    .rol-verbo { grid-row: span 2; margin: 3px 0 0; }
  }
  @media (max-width: 480px) { .rol { grid-template-columns: 1fr; } .rol-verbo { grid-row: auto; } }

  .limits { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 48px; }
  @media (max-width: 860px) { .limits { grid-template-columns: 1fr; } }
  .limits p { margin: 0; color: var(--muted); max-width: 58ch; }
  .limits strong { color: var(--ink); }

  /* ---------- Cómo se contrata ---------- */
  .fases { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 760px) { .fases { grid-template-columns: 1fr; } }
  .fases li {
    display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 18px; align-items: start;
    padding: 22px; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius);
  }
  .step-n {
    width: 44px; height: 44px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--white); border: 1px solid var(--line-strong);
    font-weight: 600; color: var(--primary);
  }
  .fases h3 { font-size: 1.15rem; margin-bottom: 4px; }
  .fases p { margin: 0; color: var(--muted); font-size: 0.97rem; }

  /* ---------- Preguntas frecuentes ---------- */
  .faq { max-width: 820px; border-top: 1px solid var(--line-strong); }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq summary {
    list-style: none; cursor: pointer;
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; align-items: center;
    padding-block: 20px;
    font-weight: 600; font-size: 1.1rem; line-height: 1.35; color: var(--ink);
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after {
    content: '+'; width: 28px; height: 28px; display: grid; place-items: center;
    border: 1px solid var(--line-strong); border-radius: 50%;
    font-weight: 400; font-size: 1.1rem; line-height: 1; color: var(--primary); background: var(--white);
  }
  .faq details[open] summary::after { content: '−'; }
  .faq summary:hover { color: var(--primary); }
  .answer { margin: 0; padding-bottom: 22px; max-width: 68ch; }

  /* ---------- Formulario ---------- */
  .contact { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 40px 72px; align-items: start; }
  @media (max-width: 920px) { .contact { grid-template-columns: 1fr; } }
  .contact-intro h2 { font-size: var(--step-3); margin-bottom: 20px; }
  .contact-intro p:not(.eyebrow) { max-width: 52ch; }
  .contact-direct {
    display: grid; justify-items: start; gap: 6px;
    margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--line);
  }
  .contact-direct p { margin: 0 0 4px; color: var(--muted); font-size: 0.95rem; }
  .contact-direct a { overflow-wrap: anywhere; }
  .contact-direct .link-arrow { margin-top: 6px; }
  .form-panel {
    position: relative; padding: clamp(20px, 4vw, 36px);
    background: var(--white); border: 1px solid var(--line); border-radius: 14px;
  }
</style>
