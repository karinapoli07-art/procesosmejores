---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContactForm from '../../components/ContactForm.astro';
import CursoCard from '../../components/CursoCard.astro';
import { contacto } from '../../data/sitio';
import { obtenerCursos } from '../../lib/cursos';

const curso = obtenerCursos().find((c) => c.slug === 'iso-27001');

const inicio = new URL('/', Astro.site).href;
const url = new URL('/servicios/vciso', Astro.site).href;

const titulo = 'vCISO: seguridad de la información e ISO/IEC 27001 | Procesos Mejores';
const descripcion =
  'Un responsable externo de seguridad de la información, unas horas por mes: riesgos, políticas, ISO/IEC 27001, cuestionarios de clientes y Ley 25.326.';

// Cuándo suele aparecer la necesidad en una pyme.
const disparadores = [
  {
    titulo: 'Un cliente te manda un cuestionario de seguridad',
    texto:
      'O pone ISO/IEC 27001 como condición en el contrato. Para responder bien hay que entender qué se pregunta y tener evidencia para mostrar.',
  },
  {
    titulo: 'La aseguradora pide controles mínimos',
    texto:
      'Para una póliza de seguro cibernético suelen preguntar por doble factor de autenticación, copias de seguridad, gestión de accesos y qué hacer ante un incidente.',
  },
  {
    titulo: 'Tu empresa maneja datos personales',
    texto:
      'La Ley 25.326 de Protección de los Datos Personales obliga a quien trata datos personales a adoptar medidas de seguridad y confidencialidad. Clientes, empleados, pacientes o alumnos: casi todas las empresas tienen bases de datos alcanzadas por la ley.',
  },
];

// Qué incluye el acompañamiento.
const incluye = [
  {
    titulo: 'Análisis y tratamiento de riesgos',
    texto:
      'Identificamos qué información es crítica, dónde está y qué puede fallar. Valoramos los riesgos y acordamos con la dirección cuáles se tratan, cómo, y cuáles se aceptan.',
  },
  {
    titulo: 'Política y roles',
    texto:
      'Redactamos la política de seguridad de la información y definimos quién decide, quién ejecuta y quién controla. Responsabilidades asignadas a personas concretas, no a un organigrama teórico.',
  },
  {
    titulo: 'Declaración de aplicabilidad y controles del Anexo A',
    texto:
      'El Anexo A de ISO/IEC 27001:2022 tiene 93 controles: organizacionales, de personas, físicos y tecnológicos. Definimos cuáles aplican y por qué, y los gestionamos con criterio, responsable y evidencia. La configuración técnica la hace tu equipo de sistemas o tu proveedor.',
  },
  {
    titulo: 'Información documentada',
    texto:
      'Políticas, procedimientos y registros a la medida de tu empresa. Lo necesario para trabajar y para demostrar que se cumple; nada de carpetas que nadie lee.',
  },
  {
    titulo: 'Cuestionarios de seguridad y auditorías de clientes',
    texto:
      'Respondemos con tu equipo los cuestionarios que mandan tus clientes y te acompañamos cuando vienen a auditarte, con la evidencia ordenada.',
  },
  {
    titulo: 'Auditorías internas y revisión por la dirección',
    texto:
      'Armamos el programa de auditorías internas y definimos quién audita, cuidando la imparcialidad. Preparamos la revisión por la dirección con los datos que pide la norma.',
  },
  {
    titulo: 'Reporte periódico a la dirección',
    texto:
      'Un informe breve y regular: estado de los riesgos, avance del plan, incidentes y decisiones pendientes. En lenguaje de negocio, para que la dirección pueda decidir.',
  },
  {
    titulo: 'Concientización del personal',
    texto:
      'Capacitaciones cortas y concretas para que la gente reconozca un intento de phishing, cuide sus accesos y sepa a quién avisar si algo sale mal.',
  },
];

const noIncluye = [
  'Tests de intrusión (pentesting)',
  'Monitoreo 24/7 de eventos de seguridad (SOC)',
  'Respuesta técnica a incidentes y análisis forense',
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'vCISO: responsable externo de seguridad de la información',
    serviceType: 'vCISO (CISO virtual)',
    description: descripcion,
    url,
    areaServed: { '@type': 'Country', name: 'Argentina' },
    provider: {
      '@type': 'ProfessionalService',
      name: 'Procesos Mejores',
      url: inicio,
      foundingDate: '2012',
    },
    about: ['ISO/IEC 27001', 'Gestión de riesgos de seguridad de la información', 'Ley 25.326'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: inicio },
      { '@type': 'ListItem', position: 2, name: 'Servicios', item: `${inicio}#servicios` },
      { '@type': 'ListItem', position: 3, name: 'vCISO', item: url },
    ],
  },
];
---
<Base title={titulo} description={descripcion} jsonLd={jsonLd}>
  <PageHeader
    eyebrow="Seguridad de la información · ISO/IEC 27001"
    title="vCISO, tu responsable externo de seguridad de la información."
    lead="Unas horas por mes, de forma continua y reportándole a la dirección. Nos ocupamos del gobierno, los riesgos y el cumplimiento, con ISO/IEC 27001 como marco de trabajo."
    crumbs={[{ label: 'Servicios', href: '/#servicios' }, { label: 'vCISO' }]}
  >
    <a class="btn btn--primary" href="#formulario-vciso">Solicitar diagnóstico inicial</a>
    <a class="btn btn--ghost btn--white" href="#incluye">Ver qué incluye</a>
  </PageHeader>

  <!-- ============ QUÉ ES ============ -->
  <section class="section">
    <div class="wrap intro">
      <div class="intro-copy">
        <p class="eyebrow">Qué es un vCISO</p>
        <h2>Alguien a cargo de la seguridad de la información, sin sumar un puesto.</h2>
        <p>
          CISO es la sigla en inglés de <span lang="en">Chief Information Security Officer</span>: la persona
          responsable de la seguridad de la información de una organización. Un vCISO, o CISO virtual, cumple
          ese rol desde afuera y con una dedicación parcial.
        </p>
        <p>
          No reemplaza a tu área de sistemas ni a tu proveedor de tecnología. Ellos operan la tecnología. El vCISO
          gobierna: define con la dirección qué hay que proteger, qué riesgos se tratan y cómo se demuestra que
          los controles funcionan.
        </p>
        <!-- A CONFIRMAR: si se quiere, citar la fuente (informe y año) del dato sobre ataques en Argentina y pymes. -->
        <p class="context">
          Y no es un tema sólo de empresas grandes. Los informes de la industria ubican a Argentina entre los
          países más atacados de la región, y la mayoría de los ataques apunta a pymes.
        </p>
      </div>

      <div class="intro-list">
        <p class="list-label">Cuándo suele aparecer la necesidad</p>
        <ul class="triggers">
          {disparadores.map((d) => (
            <li>
              <h3>{d.titulo}</h3>
              <p>{d.texto}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ QUÉ INCLUYE ============ -->
  <section class="section section--soft" id="incluye">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Qué incluye</p>
        <h2>Gobierno, riesgos y cumplimiento, de forma continua.</h2>
        <p>
          El trabajo de gestión que pide ISO/IEC 27001, sostenido mes a mes. Qué se prioriza en cada momento
          sale del plan acordado en el diagnóstico.
        </p>
      </div>

      <ul class="includes">
        {incluye.map((item) => (
          <li>
            <h3>{item.titulo}</h3>
            <p>{item.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ LÍMITES ============ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Límites claros</p>
        <h2>Lo que no hacemos, dicho desde el principio.</h2>
      </div>

      <div class="limits">
        <div>
          <h3>Qué no incluye</h3>
          <p>
            El vCISO trabaja en el gobierno de la seguridad, no en la operación técnica. Estos servicios no forman
            parte del acompañamiento:
          </p>
          <ul class="excluded">
            {noIncluye.map((n) => <li>{n}</li>)}
          </ul>
          <!-- A CONFIRMAR: nombre del socio técnico -->
          <p>
            Cuando hacen falta, los coordinamos con socios técnicos especializados: definimos qué se necesita,
            seguimos el trabajo y llevamos los resultados al análisis de riesgos.
          </p>
        </div>

        <div class="independence">
          <h3>Independencia</h3>
          <p>
            Si somos el vCISO de tu empresa, no podemos auditarla ni participar de su certificación: sería revisar
            nuestro propio trabajo.
          </p>
          <p>
            Lo dejamos por escrito en la propuesta. La certificación la otorga un organismo certificador
            independiente.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CÓMO SE CONTRATA ============ -->
  <section class="section section--soft">
    <div class="wrap hire">
      <div class="hire-intro">
        <p class="eyebrow">Cómo se contrata</p>
        <h2>Diagnóstico primero, acompañamiento después.</h2>
        <p>
          La dedicación mensual no se fija de antemano: sale de lo que encontramos en el diagnóstico. Así cada
          hora se usa en lo que más riesgo reduce.
        </p>
        <a class="btn btn--primary" href="#formulario-vciso">Solicitar diagnóstico inicial</a>
      </div>

      <ol class="steps">
        <li>
          <span class="step-n" aria-hidden="true">1</span>
          <div>
            <p class="step-kicker">Alcance cerrado</p>
            <h3>Diagnóstico inicial</h3>
            <p>
              Relevamos cómo se maneja hoy la información y qué te piden tus clientes, tu aseguradora y la ley.
              Hacemos un primer análisis de riesgos y te entregamos un plan de trabajo a 12 meses, con prioridades.
            </p>
            <!-- A CONFIRMAR: duración típica del diagnóstico inicial. -->
            <p class="step-note">La duración depende del tamaño de la organización y del alcance.</p>
            <ul class="chips">
              <li class="chip">Relevamiento</li>
              <li class="chip">Análisis de riesgos</li>
              <li class="chip">Plan a 12 meses</li>
            </ul>
          </div>
        </li>
        <li>
          <span class="step-n" aria-hidden="true">2</span>
          <div>
            <p class="step-kicker">Continuo</p>
            <h3>Acompañamiento mensual por horas</h3>
            <p>
              Ejecutamos el plan con tu equipo, unas horas por mes y de forma continua. El alcance y la dedicación
              se definen con el diagnóstico y se revisan con la dirección.
            </p>
            <ul class="chips">
              <li class="chip">Horas por mes</li>
              <li class="chip">Reporte a la dirección</li>
            </ul>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ============ FORMACIÓN ============ -->
  <section class="section">
    <div class="wrap course">
      <div class="course-copy">
        <p class="eyebrow">Formación</p>
        <h2>Para tu equipo: auditor interno ISO/IEC 27001.</h2>
        <p>
          Si querés que tu gente pueda auditar el sistema de gestión de seguridad de la información, el curso
          recorre los requisitos de la norma, la gestión de riesgos, la declaración de aplicabilidad, los
          controles del Anexo A y la auditoría según ISO 19011.
        </p>
        <a class="link-arrow" href="/cursos#iso-27001">Ver el curso</a>
      </div>
      {curso && (
        <div class="course-card">
          <CursoCard curso={curso} />
        </div>
      )}
    </div>
  </section>

  <!-- ============ PREGUNTAS FRECUENTES ============ -->
  <section class="section section--soft">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Dudas habituales</p>
        <h2>Preguntas frecuentes</h2>
      </div>

      <div class="faq">
        <details>
          <summary>¿Qué diferencia hay con un CISO interno?</summary>
          <div class="answer">
            <p>
              El rol es el mismo: alguien responsable de la seguridad de la información que le responde a la
              dirección. Cambia la dedicación. Un CISO interno es un puesto de tiempo completo; un vCISO trabaja
              unas horas por mes, de forma continua.
            </p>
            <p>
              Tiene sentido cuando la empresa necesita que alguien se haga cargo del tema, pero todavía no
              justifica un puesto propio. Y como en todo lo que hacemos, trabajamos con tu gente para que el
              conocimiento quede adentro de la organización.
            </p>
          </div>
        </details>

        <details>
          <summary>¿Cuántas horas por mes hacen falta?</summary>
          <div class="answer">
            <!-- A CONFIRMAR: si se quiere publicar un rango orientativo de horas mensuales. -->
            <p>
              Se define en el diagnóstico. Depende del tamaño de la empresa, de cuánta información sensible maneja
              y de qué le piden sus clientes, su aseguradora o la ley. La dedicación se puede revisar a medida que
              el sistema madura.
            </p>
          </div>
        </details>

        <details>
          <summary>¿Necesito estar certificado en ISO/IEC 27001?</summary>
          <div class="answer">
            <p>
              No. Usamos ISO/IEC 27001 como marco porque ordena la gestión de la seguridad de la información y es
              la referencia que piden muchos clientes. Certificar es una decisión aparte.
            </p>
            <p>
              Si un contrato lo exige, el trabajo apunta a que llegues a la auditoría de un organismo certificador.
              Si no, igual tenés un sistema ordenado y evidencia para mostrar.
            </p>
          </div>
        </details>

        <details>
          <summary>¿El vCISO reemplaza a mi área de sistemas?</summary>
          <div class="answer">
            <p>
              No. Tu área de sistemas o tu proveedor operan la tecnología: servidores, cuentas, copias de seguridad,
              configuraciones. El vCISO define qué hay que proteger y con qué prioridad, fija los criterios y
              controla que se cumplan. Trabajamos juntos.
            </p>
          </div>
        </details>

        <details>
          <summary>Ya tenemos ISO 9001. ¿Sirve como base?</summary>
          <div class="answer">
            <p>
              Sí. La gestión de la documentación, las auditorías internas, las acciones correctivas y la revisión por la dirección
              se pueden aprovechar para el sistema de seguridad de la información. Lo que hay que sumar es el
              análisis de riesgos específico, la identificación de activos de información y los controles del
              Anexo A.
            </p>
            <p><a class="link-arrow" href="/blog/iso-9001-e-iso-27001">Leer el artículo sobre ISO 9001 e ISO/IEC 27001</a></p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- ============ FORMULARIO ============ -->
  <section class="section" id="formulario-vciso">
    <div class="wrap contact">
      <div class="contact-intro">
        <p class="eyebrow">Contacto</p>
        <h2>Contanos qué te están pidiendo.</h2>
        <p>
          Un cuestionario de seguridad de un cliente, un contrato que exige ISO/IEC 27001, una póliza cibernética o
          la necesidad de ordenar cómo se cuida la información. Con eso coordinamos una primera conversación.
        </p>
        <div class="contact-direct">
          <p>¿Preferís escribirnos directo?</p>
          <a href={`mailto:${contacto.email}`}>{contacto.email}</a>
          <a href={contacto.telefonoLink}>{contacto.telefono}</a>
          <a class="link-arrow" href={contacto.whatsapp} target="_blank" rel="noopener">Escribir por WhatsApp</a>
        </div>
      </div>

      <div class="form-panel">
        <ContactForm servicio="vciso" />
      </div>
    </div>
  </section>
</Base>

<style>
  .btn--white { background: var(--white); }
  /* La regla global `.section-head p` pisa al .eyebrow dentro del encabezado de sección. */

  /* ---------- Qué es ---------- */
  .intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px 80px; align-items: start; }
  @media (max-width: 920px) { .intro { grid-template-columns: 1fr; } }
  .intro-copy h2 { font-size: var(--step-3); margin-bottom: 20px; }
  .intro-copy p:not(.eyebrow) { max-width: 58ch; }
  .context { margin: 28px 0 0; padding-left: 16px; border-left: 2px solid var(--brand); color: var(--muted); }

  .list-label {
    font-family: var(--font-display); font-size: 0.78rem; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted);
    margin: 6px 0 12px;
  }
  .triggers { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .triggers li { padding-block: 22px; border-bottom: 1px solid var(--line); }
  .triggers h3 { font-size: 1.1rem; margin-bottom: 6px; }
  .triggers p { margin: 0; color: var(--muted); font-size: 0.97rem; }

  /* ---------- Qué incluye ---------- */
  .includes { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  .includes li {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: 8px 48px;
    align-items: start; padding-block: 24px; border-bottom: 1px solid var(--line);
  }
  @media (max-width: 760px) { .includes li { grid-template-columns: 1fr; padding-block: 20px; } }
  .includes h3 { font-size: 1.15rem; }
  .includes p { margin: 0; color: var(--muted); max-width: 64ch; }

  /* ---------- Límites ---------- */
  .limits { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 40px 72px; align-items: start; }
  @media (max-width: 860px) { .limits { grid-template-columns: 1fr; } }
  .limits h3 { font-size: var(--step-1); margin-bottom: 12px; }
  .limits p { max-width: 58ch; }
  .excluded { list-style: none; margin: 0 0 20px; padding: 0; border-top: 1px solid var(--line); }
  .excluded li {
    padding-block: 14px; border-bottom: 1px solid var(--line);
    font-family: var(--font-display); font-weight: 600; color: var(--ink);
  }
  .independence {
    position: relative; padding: 28px;
    background: var(--soft); border: 1px solid var(--line); border-radius: var(--radius);
  }
  .independence p:last-child { margin-bottom: 0; }

  /* ---------- Cómo se contrata ---------- */
  .hire { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 48px 80px; align-items: start; }
  @media (max-width: 920px) { .hire { grid-template-columns: 1fr; } }
  .hire-intro h2 { font-size: var(--step-3); margin-bottom: 20px; }
  .hire-intro p:not(.eyebrow) { max-width: 52ch; }
  .hire-intro .btn { margin-top: 12px; }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; }
  .steps > li { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 20px; padding-block: 24px; border-bottom: 1px solid var(--line); }
  .steps > li:first-child { padding-top: 0; }
  .steps > li:last-child { border-bottom: 0; }
  .step-n {
    width: 44px; height: 44px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--white); border: 1px solid var(--line-strong);
    font-family: var(--font-display); font-weight: 600; color: var(--primary);
  }
  .step-kicker {
    margin: 0 0 4px; font-family: var(--font-display); font-size: 0.78rem; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--primary);
  }
  .steps h3 { font-size: 1.15rem; margin-bottom: 6px; }
  .steps p:not(.step-kicker) { margin: 0 0 12px; color: var(--muted); font-size: 0.97rem; }
  .steps .step-note { font-size: 0.9rem; }
  .steps .chips { margin-top: 4px; }

  /* ---------- Formación ---------- */
  .course { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 40px 72px; align-items: center; }
  @media (max-width: 860px) { .course { grid-template-columns: 1fr; } }
  .course-copy h2 { font-size: var(--step-3); margin-bottom: 20px; }
  .course-copy p:not(.eyebrow) { max-width: 56ch; }
  .course-card { max-width: 460px; }

  /* ---------- Preguntas frecuentes ---------- */
  .faq { max-width: 820px; border-top: 1px solid var(--line-strong); }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq summary {
    list-style: none; cursor: pointer;
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; align-items: center;
    padding-block: 20px;
    font-family: var(--font-display); font-weight: 600; font-size: 1.1rem; line-height: 1.35; color: var(--ink);
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after {
    content: '+'; width: 28px; height: 28px; display: grid; place-items: center;
    border: 1px solid var(--line-strong); border-radius: 50%;
    font-weight: 400; font-size: 1.1rem; line-height: 1; color: var(--primary); background: var(--white);
  }
  .faq details[open] summary::after { content: '−'; }
  .faq summary:hover { color: var(--primary); }
  .answer { padding-bottom: 22px; max-width: 68ch; }
  .answer p:last-child { margin-bottom: 0; }
  .answer .link-arrow { white-space: normal; }

  /* ---------- Formulario ---------- */
  .contact { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 40px 72px; align-items: start; }
  @media (max-width: 920px) { .contact { grid-template-columns: 1fr; } }
  .contact-intro h2 { font-size: var(--step-3); margin-bottom: 20px; }
  .contact-intro p:not(.eyebrow) { max-width: 52ch; }
  .contact-direct {
    display: grid; justify-items: start; gap: 6px;
    margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--line);
  }
  .contact-direct p { margin: 0 0 4px; color: var(--muted); font-size: 0.95rem; }
  .contact-direct a { overflow-wrap: anywhere; }
  .contact-direct .link-arrow { margin-top: 6px; }
  .form-panel {
    position: relative; padding: clamp(20px, 4vw, 36px);
    background: var(--white); border: 1px solid var(--line); border-radius: 14px;
  }
</style>
