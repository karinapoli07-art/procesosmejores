---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import fotoLean from '../../assets/fotos/lean.webp';
import CursoCard from '../../components/CursoCard.astro';
import CtaDiagnostico from '../../components/CtaDiagnostico.astro';
import { obtenerCursos } from '../../lib/cursos';
import rodrigo from '../../assets/rodrigo.png';

const SITIO = 'https://www.procesosmejores.com';
const URL_PAGINA = `${SITIO}/servicios/lean-manufacturing`;
const contactoLean = '/contacto?servicio=lean#formulario';

const titulo = 'Consultoría Lean Manufacturing (TPS) | Procesos Mejores';
const descripcion =
  'Lean Manufacturing desde el Sistema de Producción Toyota: mapeo del flujo de valor, 5S, trabajo estandarizado, kaizen y gestión visual, con tu equipo.';

const curso5s = obtenerCursos().find((c) => c.slug === '5s-profesional');

// Los siete desperdicios (muda) del TPS, en una línea cada uno.
const desperdicios = [
  { nombre: 'Sobreproducción', texto: 'Producir más, o antes, de lo necesario.' },
  { nombre: 'Esperas', texto: 'Gente o máquinas paradas.' },
  { nombre: 'Transporte', texto: 'Mover cosas sin agregarles nada.' },
  { nombre: 'Sobreprocesamiento', texto: 'Pasos que el cliente no valora.' },
  { nombre: 'Inventario', texto: 'Stock de más que tapa problemas.' },
  { nombre: 'Movimientos', texto: 'Buscar, caminar de más, agacharse.' },
  { nombre: 'Defectos', texto: 'Hacer dos veces lo mismo.' },
];

// Qué hacemos. Sin resultados cuantitativos: el alcance se define en el diagnóstico.
const servicios = [
  {
    nombre: 'Mapeo del flujo de valor',
    etiquetas: ['VSM', 'Gemba'],
    texto: 'Recorremos el proceso con tu equipo y dibujamos dónde se espera, se acumula o se retrabaja. De ahí sale el plan.',
  },
  {
    nombre: '5S',
    etiquetas: ['Clasificar', 'Ordenar', 'Limpiar', 'Estandarizar', 'Sostener'],
    texto: 'Un puesto ordenado deja ver los problemas. Lo importante es que el orden se sostenga.',
  },
  {
    nombre: 'Trabajo estandarizado',
    etiquetas: ['Takt time', 'Secuencia'],
    texto: 'La mejor forma conocida de hacer cada tarea, definida con quienes la hacen.',
  },
  {
    nombre: 'Kaizen y resolución de problemas',
    etiquetas: ['PDCA', 'A3', '5 porqués'],
    texto: 'Atacar problemas con método: ir a ver, encontrar la causa raíz y probar soluciones.',
  },
  {
    nombre: 'Gestión visual',
    etiquetas: ['Tableros', 'Andon'],
    texto: 'Indicadores a la vista para saber, de un vistazo, si el proceso va bien.',
  },
];

const preguntas = [
  {
    q: '¿Lean sirve fuera de la industria automotriz?',
    a: 'Sí. Nació en Toyota, pero se aplica en plantas de alimentos, metalmecánicas o químicas, en depósitos y en logística.',
  },
  {
    q: '¿Y en tareas administrativas?',
    a: 'También: trámites esperando una firma, datos que se cargan dos veces, errores que vuelven como reclamos. 5S y el mapeo del flujo se aplican igual.',
  },
  {
    q: '¿Por dónde se empieza?',
    a: 'Por mirar el proceso real y elegir un área piloto. Muchas veces el primer paso es 5S. No hace falta comprar software ni equipos.',
  },
  {
    q: '¿Necesito tener ISO 9001?',
    a: 'No. Se pueden empezar por separado, y lo que ordenes con Lean es una buena base para un sistema de gestión.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Consultoría en Lean Manufacturing',
    serviceType: 'Consultoría en Lean Manufacturing y Sistema de Producción Toyota',
    description: descripcion,
    url: URL_PAGINA,
    areaServed: 'AR',
    availableLanguage: 'es',
    provider: {
      '@type': 'ProfessionalService',
      name: 'Procesos Mejores',
      url: `${SITIO}/`,
    },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Lean Manufacturing',
      itemListElement: servicios.map((s) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: s.nombre },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITIO}/` },
      { '@type': 'ListItem', position: 2, name: 'Servicios', item: `${SITIO}/#servicios` },
      { '@type': 'ListItem', position: 3, name: 'Lean Manufacturing', item: URL_PAGINA },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: preguntas.map((p) => ({
      '@type': 'Question',
      name: p.q,
      acceptedAnswer: { '@type': 'Answer', text: p.a },
    })),
  },
];
---
<Base title={titulo} description={descripcion} jsonLd={jsonLd}>
  <PageHeader
    eyebrow="Mejora de procesos"
    ilustracion="lean"
    foto={fotoLean}
    fotoAlt="Planta ordenada con un tablero de gestión visual y dos personas conversando frente a él"
    title="Lean Manufacturing"
    lead="El Sistema de Producción Toyota aplicado a tu operación, construido con las personas que hacen el trabajo todos los días."
    crumbs={[{ label: 'Servicios', href: '/#servicios' }, { label: 'Lean Manufacturing' }]}
  >
    <a class="btn btn--primary" href={contactoLean}>Solicitar diagnóstico inicial</a>
    <a class="btn btn--ghost btn--onsoft" href="/cursos#5s-profesional">Curso 5S Profesional</a>
  </PageHeader>

  <!-- ============ QUÉ ES LEAN ============ -->
  <section class="section" aria-labelledby="que-es">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Qué es Lean</p>
        <h2 id="que-es">Sacar del proceso todo lo que no agrega valor.</h2>
        <p>Lean es el nombre que se le dio en Occidente al Sistema de Producción Toyota. Busca siete desperdicios:</p>
      </div>
      <ol class="mudas">
        {desperdicios.map((d) => (
          <li>
            <h3>{d.nombre}</h3>
            <p>{d.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ QUÉ HACEMOS ============ -->
  <section class="section section--soft" aria-labelledby="que-hacemos">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Qué hacemos</p>
        <h2 id="que-hacemos">Herramientas Lean, en tu proceso y con tu equipo.</h2>
        <p>No hace falta hacer todo junto: el diagnóstico define por dónde empezar.</p>
      </div>

      <ul class="offer">
        {servicios.map((s) => (
          <li class="offer-item">
            <h3>{s.nombre}</h3>
            <p>{s.texto}</p>
            <ul class="chips">{s.etiquetas.map((e) => <li class="chip">{e}</li>)}</ul>
          </li>
        ))}
      </ul>
      <!-- A CONFIRMAR: modalidad (presencial en planta / mixta) y zona de cobertura para este servicio. -->
    </div>
  </section>

  <!-- ============ DIFERENCIAL: TOYOTA ============ -->
  <section class="section toyota" aria-labelledby="por-que">
    <div class="wrap toyota-grid">
      <div class="toyota-photo">
        <Image src={rodrigo} alt="Rodrigo Arizmendi, fundador de Procesos Mejores" width={160} widths={[120, 160, 320]} sizes="(max-width: 640px) 120px, 160px" />
      </div>
      <div class="toyota-copy">
        <p class="eyebrow">Por qué con nosotros</p>
        <h2 id="por-que">La mejora continua, vista desde adentro de Toyota.</h2>
        <p>
          Para nosotros, Lean no es un conjunto de herramientas sueltas. Es una forma de trabajar que
          empieza en el lugar donde se hace el trabajo y se sostiene con las personas que lo hacen.
        </p>
        <a class="link-arrow" href="/nosotros">Conocé nuestra historia</a>
      </div>
    </div>
  </section>

  <!-- ============ CURSO RELACIONADO ============ -->
  <section class="section section--soft" aria-labelledby="curso">
    <div class="wrap course">
      <div class="course-copy">
        <p class="eyebrow">Formación</p>
        <h2 id="curso">5S Profesional, en un curso en vivo.</h2>
        <p>Por Google Meet. Para un equipo entero, lo armamos a medida.</p>
        <a class="link-arrow" href="/cursos">Ver todos los cursos</a>
      </div>
      {curso5s && (
        <div class="course-card">
          <CursoCard curso={curso5s} />
        </div>
      )}
    </div>
  </section>

  <!-- ============ PREGUNTAS FRECUENTES ============ -->
  <section class="section" aria-labelledby="faq">
    <div class="wrap faq">
      <div class="section-head">
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2 id="faq">Lo que suelen preguntarnos.</h2>
      </div>
      <div class="faq-list">
        {preguntas.map((p) => (
          <details>
            <summary><h3>{p.q}</h3></summary>
            <p>{p.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaDiagnostico
    servicio="lean"
    title="¿Por dónde empezar? Por recorrer tu proceso."
    text="Vemos con vos cómo fluye hoy el trabajo y te proponemos por dónde arrancar."
  />
</Base>

<style>
  .btn--onsoft { background: var(--white); }

  /* ---------- Los siete desperdicios ---------- */
  .mudas {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px;
  }
  .mudas li {
    padding: 20px; border: 1px solid var(--line-strong); border-radius: var(--radius); background: var(--white);
    transition: border-color var(--base) var(--ease), transform var(--base) var(--ease);
  }
  @media (hover: hover) { .mudas li:hover { border-color: var(--primary); transform: translateY(-3px); } }
  .mudas h3 { font-size: 1.1rem; margin-bottom: 4px; }
  .mudas p { margin: 0; color: var(--muted); font-size: 0.95rem; line-height: 1.45; }

  /* ---------- Qué hacemos ---------- */
  .offer {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr)); gap: 12px;
  }
  .offer-item {
    display: grid; align-content: start; gap: 10px;
    padding: 24px; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius);
  }
  .offer-item h3 { font-size: var(--step-1); }
  .offer-item > p { margin: 0; color: var(--muted); }

  /* ---------- Toyota ---------- */
  .toyota-grid { display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 32px 56px; align-items: center; }
  @media (max-width: 640px) { .toyota-grid { grid-template-columns: 1fr; } }
  .toyota-copy { max-width: 720px; }
  .toyota-photo img { width: 100%; max-width: 160px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--white); }
  @media (max-width: 640px) { .toyota-photo img { max-width: 120px; } }
  .toyota-copy h2 { font-size: var(--step-3); margin-bottom: 20px; }
  .toyota-copy > p { max-width: 60ch; }

  /* ---------- Curso ---------- */
  .course { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 40px 72px; align-items: center; }
  @media (max-width: 860px) { .course { grid-template-columns: 1fr; } }
  .course-copy h2 { font-size: var(--step-3); margin-bottom: 20px; }
  .course-copy p { max-width: 56ch; }
  .course-card { max-width: 440px; width: 100%; }

  /* ---------- Preguntas frecuentes ---------- */
  .faq-list { border-top: 1px solid var(--line); max-width: 820px; }
  details { border-bottom: 1px solid var(--line); }
  summary {
    display: flex; justify-content: space-between; align-items: center; gap: 24px;
    padding-block: 22px; cursor: pointer; list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary h3 { font-size: 1.1rem; font-weight: 600; }
  summary::after {
    content: '+'; flex: none; width: 28px; height: 28px; display: grid; place-items: center;
    border: 1px solid var(--line-strong); border-radius: 50%;
    font-family: var(--font-display); font-size: 1.1rem; line-height: 1; color: var(--primary);
    transition: transform .15s ease;
  }
  details[open] summary::after { transform: rotate(45deg); }
  summary:hover h3 { color: var(--primary); }
  details p { margin: 0 0 24px; color: var(--text); max-width: 68ch; }
</style>
